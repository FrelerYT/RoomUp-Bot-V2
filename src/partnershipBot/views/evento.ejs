<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.title %> | Votazioni Server</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #ff595e;
      --bg-gradient: linear-gradient(150deg, #ff6b70 0%, #ff595e 50%, #fa474e 100%);
      --card-bg: #ffffff;
      --dark-nero: #002a32;
      --text-main: #002a32;
      --text-muted: rgba(0, 42, 50, 0.72);
      --primary: #ff595e;
      --primary-hover: #e84348;
      --btn-join-bg: #f0f6f8;
      --btn-join-color: #002a32;
      --btn-join-border: rgba(0, 42, 50, 0.15);
      --btn-join-hover: #002a32;
      --btn-join-hover-color: #ffffff;
      --discord: #5865f2;
      --discord-hover: #4752c4;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      background-image: var(--bg-gradient);
      background-attachment: fixed;
      color: var(--text-main);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      max-width: 1020px;
      margin: 0 auto;
      padding: 30px 20px 60px;
      width: 100%;
      flex: 1;
    }

    /* Affiliate Showcase Section at Top */
    .affiliate-showcase-section {
      background: #ffffff;
      border-radius: 14px;
      padding: 22px 24px;
      margin-bottom: 24px;
      border: 1px solid rgba(0, 42, 50, 0.08);
      box-shadow: 0 16px 36px rgba(0, 42, 50, 0.2), 0 4px 12px rgba(0, 42, 50, 0.1);
    }

    .affiliate-showcase-header {
      margin-bottom: 16px;
    }

    .affiliate-showcase-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 5px 12px;
      border-radius: 14px;
      font-size: 11.5px;
      font-weight: 700;
      background: rgba(255, 89, 94, 0.12);
      color: var(--primary);
      margin-bottom: 8px;
      letter-spacing: 0.2px;
    }

    .affiliate-showcase-title {
      font-size: 20px;
      font-weight: 800;
      color: var(--dark-nero);
      letter-spacing: -0.3px;
      margin-bottom: 4px;
    }

    .affiliate-showcase-subtitle {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.45;
    }

    .affiliate-showcase-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
    }

    .affiliate-showcase-card {
      background: #f8fafc;
      border: 1.5px solid rgba(0, 42, 50, 0.08);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      box-shadow: 0 4px 12px rgba(0, 42, 50, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .affiliate-showcase-card:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 89, 94, 0.4);
      box-shadow: 0 8px 20px rgba(0, 42, 50, 0.12);
    }
    .affiliate-showcase-card.card-is-member {
      background: #f0fdf4;
      border-color: #bbf7d0;
    }

    .aff-card-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .aff-icon-wrap {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      overflow: hidden;
      flex-shrink: 0;
      border: 2px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 3px 8px rgba(0, 42, 50, 0.15);
      background: #002a32;
    }

    .aff-icon-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .aff-icon-fallback {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ff595e, #002a32);
      color: #ffffff;
      font-size: 20px;
      font-weight: 800;
    }

    .aff-info-col {
      min-width: 0;
    }

    .aff-name {
      font-size: 15px;
      font-weight: 800;
      color: var(--dark-nero);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: -0.2px;
      margin-bottom: 2px;
    }

    .aff-meta {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 600;
    }

    .aff-card-right {
      flex-shrink: 0;
    }

    .btn-aff-enter {
      background: var(--dark-nero);
      color: #ffffff;
      padding: 8px 14px;
      border-radius: 14px;
      font-size: 12.5px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 3px 10px rgba(0, 42, 50, 0.15);
      transition: all 0.15s ease;
      white-space: nowrap;
      font-family: inherit;
    }
    .btn-aff-enter:hover {
      background: var(--primary);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(255, 89, 94, 0.35);
    }

    .aff-pill-joined {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 14px;
      font-size: 12px;
      font-weight: 700;
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #86efac;
    }

    /* Discord Authentication Bar / Cards */
    .auth-container {
      margin-bottom: 28px;
    }

    .auth-card {
      background: #ffffff;
      border-radius: 14px;
      padding: 18px 24px;
      box-shadow: 0 14px 34px rgba(0, 42, 50, 0.2), 0 4px 10px rgba(0, 42, 50, 0.1);
      border: 1px solid rgba(0, 42, 50, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      transition: box-shadow 0.2s ease;
    }

    .auth-card-top-layout {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }

    .auth-card-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      width: 100%;
    }

    .auth-card-left {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }

    .auth-icon-badge {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: rgba(88, 101, 242, 0.12);
      color: var(--discord);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .auth-avatar-wrap {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      overflow: hidden;
      flex-shrink: 0;
      border: 2px solid rgba(0, 42, 50, 0.1);
      box-shadow: 0 3px 8px rgba(0, 42, 50, 0.15);
      background: #002a32;
    }

    .auth-avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .auth-info-col {
      min-width: 0;
    }

    .auth-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--dark-nero);
      margin-bottom: 2px;
      letter-spacing: -0.2px;
    }

    .auth-desc {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .auth-user-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 2px;
      flex-wrap: wrap;
    }

    .auth-username {
      font-size: 16px;
      font-weight: 800;
      color: var(--dark-nero);
    }

    .auth-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 14px;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    .status-verified {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    .status-warning {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    .status-voted {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 2.5px;
      display: inline-block;
    }

    .status-dot-green {
      background: #10b981;
      box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
    }

    .status-dot-red {
      background: #ef4444;
      box-shadow: 0 0 6px rgba(239, 68, 68, 0.6);
    }

    .auth-card-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    /* Buttons */
    .btn-discord-login {
      background: var(--discord);
      color: #ffffff;
      padding: 11px 22px;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 6px 18px rgba(88, 101, 242, 0.35), 0 2px 6px rgba(0, 42, 50, 0.12);
      transition: all 0.15s ease;
      white-space: nowrap;
      font-family: inherit;
    }
    .btn-discord-login:hover {
      background: var(--discord-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(88, 101, 242, 0.45);
    }

    .btn-action-outline {
      background: #f0f6f8;
      color: var(--dark-nero);
      border: 1px solid rgba(0, 42, 50, 0.15);
      border-radius: 14px;
      padding: 9px 16px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      box-shadow: 0 2px 6px rgba(0, 42, 50, 0.08);
      transition: all 0.15s ease;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }
    .btn-action-outline:hover {
      background: var(--dark-nero);
      color: #ffffff;
      border-color: var(--dark-nero);
      transform: translateY(-1px);
    }

    .btn-refresh {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }
    .btn-refresh:hover {
      background: #10b981;
      color: #ffffff;
      border-color: #10b981;
    }

    /* Affiliate Server Join Box */
    .affiliate-section {
      background: #f8fafc;
      border-radius: 14px;
      padding: 16px;
      border: 1px solid rgba(0, 42, 50, 0.08);
      margin-top: 4px;
    }

    .affiliate-title {
      font-size: 13px;
      font-weight: 800;
      color: var(--dark-nero);
      margin-bottom: 12px;
      letter-spacing: -0.1px;
    }

    .affiliate-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
    }

    .affiliate-card {
      background: #ffffff;
      border-radius: 14px;
      padding: 12px 16px;
      border: 1px solid rgba(0, 42, 50, 0.1);
      box-shadow: 0 4px 10px rgba(0, 42, 50, 0.06);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .affiliate-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--dark-nero);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .btn-affiliate-enter {
      background: #002a32;
      color: #ffffff;
      padding: 7px 14px;
      border-radius: 14px;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }
    .btn-affiliate-enter:hover {
      background: var(--primary);
      transform: translateY(-1px);
    }

    /* Notice Banner for Errors */
    .alert-banner {
      background: #ffffff;
      border-radius: 14px;
      padding: 12px 20px;
      margin-bottom: 20px;
      border-left: 5px solid #ef4444;
      box-shadow: 0 8px 20px rgba(0, 42, 50, 0.15);
      color: var(--dark-nero);
      font-size: 13.5px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Hero Section */
    .hero {
      text-align: center;
      margin-bottom: 35px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: 14px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.2px;
      background: #ffffff;
      color: var(--dark-nero);
      box-shadow: 0 8px 20px rgba(0, 42, 50, 0.22), 0 2px 6px rgba(0, 42, 50, 0.12);
    }
    .badge-dot {
      width: 9px;
      height: 9px;
      border-radius: 3.5px;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
    }
    .badge-paused .badge-dot {
      background: #f59e0b;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
    }
    .badge-ended .badge-dot {
      background: #ef4444;
      box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
    }

    .hero-title {
      font-size: 38px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #ffffff;
      margin-bottom: 10px;
      text-shadow: 0 4px 16px rgba(0, 42, 50, 0.35);
    }

    .hero-desc {
      font-size: 15.5px;
      color: rgba(255, 255, 255, 0.95);
      max-width: 640px;
      margin: 0 auto 22px;
      text-shadow: 0 2px 8px rgba(0, 42, 50, 0.2);
    }

    /* Prize Box */
    .prize-box {
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid rgba(255, 89, 94, 0.25);
      padding: 14px 22px;
      max-width: 650px;
      margin: 0 auto 25px;
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
      box-shadow: 0 16px 36px rgba(0, 42, 50, 0.22), 0 6px 14px rgba(0, 42, 50, 0.12);
    }
    .prize-icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .prize-title {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: 0.5px;
    }
    .prize-text {
      font-size: 14px;
      font-weight: 700;
      color: var(--dark-nero);
    }

    /* Countdown Widget */
    .countdown-widget {
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid rgba(255, 89, 94, 0.25);
      padding: 14px 22px;
      max-width: 520px;
      margin: 0 auto 24px;
      box-shadow: 0 16px 36px rgba(0, 42, 50, 0.22), 0 6px 14px rgba(0, 42, 50, 0.12);
      text-align: center;
    }
    .countdown-head {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: var(--dark-nero);
      margin-bottom: 10px;
    }
    .countdown-head svg {
      color: var(--primary);
    }
    .countdown-grid {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .cd-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 58px;
      padding: 6px 10px;
      background: #f8fafc;
      border-radius: 10px;
      border: 1px solid rgba(0, 42, 50, 0.08);
    }
    .cd-val {
      font-size: 20px;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.1;
      font-variant-numeric: tabular-nums;
    }
    .cd-lbl {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-top: 3px;
      letter-spacing: 0.3px;
    }
    .cd-colon {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-muted);
      margin-top: -10px;
    }

    /* Stats Bar */
    .stats-bar {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 30px;
    }
    .stat-pill {
      background: #ffffff;
      padding: 8px 18px;
      border-radius: 14px;
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 600;
      border: 1px solid rgba(0, 42, 50, 0.08);
      box-shadow: 0 8px 20px rgba(0, 42, 50, 0.18), 0 2px 6px rgba(0, 42, 50, 0.1);
    }
    .stat-pill strong {
      color: var(--primary);
      font-weight: 800;
    }

    /* Server Grid */
    .server-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }

    .server-card {
      background: var(--card-bg);
      border: 1px solid rgba(0, 42, 50, 0.08);
      border-radius: 14px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 14px 28px rgba(0, 42, 50, 0.18), 0 6px 12px rgba(0, 42, 50, 0.12);
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }
    .server-card:hover {
      transform: translateY(-5px);
      border-color: rgba(255, 89, 94, 0.45);
      box-shadow: 0 20px 40px rgba(0, 42, 50, 0.28), 0 8px 16px rgba(0, 42, 50, 0.16);
    }

    /* Server Banner Header */
    .server-banner-header {
      position: relative;
      width: 100%;
      height: 140px;
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      align-items: center;
      padding: 16px;
      background: #002a32;
      box-shadow: 0 6px 16px rgba(0, 42, 50, 0.15);
      margin-bottom: 14px;
    }

    .banner-bg-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: 1;
      transition: transform 0.35s ease;
    }
    .server-card:hover .banner-bg-img {
      transform: scale(1.05);
    }
    .banner-bg-blur {
      filter: blur(8px) brightness(0.7);
      transform: scale(1.15);
    }

    .banner-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.38) 100%);
      z-index: 2;
      pointer-events: none;
    }

    .banner-rank-badge {
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 4;
    }
    .rank-pill {
      font-size: 11.5px;
      font-weight: 800;
      padding: 5px 13px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      letter-spacing: 0.3px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.28);
    }
    .rank-1 {
      background: #ffffff;
      color: #b45309;
      border: 1.5px solid #fde68a;
    }
    .rank-2 {
      background: #ffffff;
      color: var(--dark-nero);
      border: 1.5px solid rgba(0, 42, 50, 0.2);
    }
    .rank-3 {
      background: #ffffff;
      color: var(--primary);
      border: 1.5px solid rgba(255, 89, 94, 0.35);
    }
    .rank-other {
      background: rgba(255, 255, 255, 0.92);
      color: var(--dark-nero);
      border: 1px solid rgba(0, 42, 50, 0.12);
    }

    .banner-content {
      position: relative;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      padding-right: 80px;
    }

    .server-icon-wrap {
      width: 60px;
      height: 60px;
      flex-shrink: 0;
      border-radius: 14px;
      overflow: hidden;
      border: 2.5px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
      background: #002a32;
    }
    .server-icon-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .server-icon-fallback {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ff595e, #002a32);
      color: #ffffff;
      font-size: 24px;
      font-weight: 800;
    }

    .server-info-col {
      min-width: 0;
      flex: 1;
    }
    .server-name {
      color: #ffffff;
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -0.3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    }

    .server-desc {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 14px;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      padding: 0 2px;
    }

    .server-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: auto;
    }

    .btn-vote {
      flex: 1;
      background: linear-gradient(135deg, #ff6b70 0%, #ff595e 100%);
      color: #ffffff;
      border: none;
      border-radius: 14px;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 18px rgba(237, 37, 78, 0.45), 0 2px 6px rgba(0, 42, 50, 0.15);
      transition: all 0.15s ease;
      font-family: inherit;
    }
    .btn-vote:hover:not(:disabled) {
      background: linear-gradient(135deg, #ff595e 0%, #e03f44 100%);
      box-shadow: 0 10px 24px rgba(237, 37, 78, 0.6), 0 4px 10px rgba(0, 42, 50, 0.2);
      transform: translateY(-2px);
    }
    .btn-vote:active:not(:disabled) {
      transform: translateY(0);
    }
    .btn-vote:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      box-shadow: none;
    }

    .btn-vote-voted {
      background: #002a32 !important;
      color: #ffffff !important;
      box-shadow: 0 4px 14px rgba(0, 42, 50, 0.25) !important;
      cursor: default !important;
      opacity: 1 !important;
    }

    .btn-vote-disabled {
      background: #f1f5f9 !important;
      color: rgba(0, 42, 50, 0.55) !important;
      border: 1px solid rgba(0, 42, 50, 0.1) !important;
      box-shadow: none !important;
      cursor: not-allowed !important;
      opacity: 0.75 !important;
    }
    .btn-vote-disabled .vote-chip {
      background: rgba(0, 42, 50, 0.08) !important;
      color: rgba(0, 42, 50, 0.65) !important;
    }

    .vote-chip {
      background: rgba(255, 255, 255, 0.25);
      padding: 3px 9px;
      border-radius: 14px;
      font-size: 12.5px;
      font-weight: 800;
      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .btn-join {
      background: var(--btn-join-bg);
      color: var(--btn-join-color);
      border: 1px solid var(--btn-join-border);
      border-radius: 14px;
      padding: 11px 14px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      box-shadow: 0 4px 14px rgba(0, 42, 50, 0.12);
      transition: all 0.15s ease;
      white-space: nowrap;
      font-family: inherit;
    }
    .btn-join:hover {
      background: var(--btn-join-hover);
      color: var(--btn-join-hover-color);
      border-color: var(--dark-nero);
      box-shadow: 0 8px 20px rgba(0, 42, 50, 0.25);
      transform: translateY(-2px);
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid rgba(0, 42, 50, 0.08);
      box-shadow: 0 16px 36px rgba(0, 42, 50, 0.22);
      color: var(--text-muted);
    }

    #toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #ffffff;
      color: var(--dark-nero);
      padding: 14px 20px;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 16px 40px rgba(0, 42, 50, 0.35), 0 6px 14px rgba(0, 42, 50, 0.15);
      display: none;
      z-index: 1000;
      border: 1px solid rgba(0, 42, 50, 0.12);
      animation: popIn 0.2s ease;
      max-width: 380px;
    }
    #toast.success {
      border-left: 4px solid var(--primary);
    }
    #toast.error {
      border-left: 4px solid #ef4444;
    }
    #toast.warning {
      border-left: 4px solid #f59e0b;
    }

    @keyframes popIn {
      from { opacity: 0; transform: translateY(8px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    footer {
      text-align: center;
      padding: 26px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.95);
      text-shadow: 0 2px 6px rgba(0, 42, 50, 0.25);
      margin-top: auto;
    }

    /* Points Rule Section & Scoring Matrix */
    .points-rule-section {
      background: #ffffff;
      border-radius: 14px;
      padding: 22px 24px;
      margin-bottom: 24px;
      border: 1px solid rgba(0, 42, 50, 0.08);
      box-shadow: 0 16px 36px rgba(0, 42, 50, 0.2), 0 4px 12px rgba(0, 42, 50, 0.1);
    }
    .points-rule-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 8px;
    }
    .points-rule-title-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .points-rule-icon {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: rgba(255, 89, 94, 0.12);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .points-rule-title {
      font-size: 19px;
      font-weight: 800;
      color: var(--dark-nero);
      letter-spacing: -0.3px;
    }
    .points-rule-base-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #002a32;
      color: #ffffff;
      padding: 6px 14px;
      border-radius: 14px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }
    .points-rule-desc {
      font-size: 13.5px;
      color: var(--text-muted);
      margin-bottom: 16px;
      line-height: 1.45;
    }
    .points-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
    }
    .points-card {
      background: #f8fafc;
      border: 1.5px solid rgba(0, 42, 50, 0.08);
      border-radius: 14px;
      padding: 14px 16px;
      box-shadow: 0 4px 12px rgba(0, 42, 50, 0.05);
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .points-card:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 89, 94, 0.35);
    }
    .points-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 800;
      font-size: 14.5px;
      color: var(--dark-nero);
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(0, 42, 50, 0.06);
    }
    .points-card-name {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .points-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      padding: 6px 0;
    }
    .points-row:not(:last-child) {
      border-bottom: 1px dashed rgba(0, 42, 50, 0.08);
    }
    .points-label {
      color: #475569;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .points-val {
      font-weight: 800;
      font-size: 12.5px;
      padding: 3px 10px;
      border-radius: 10px;
      background: rgba(255, 89, 94, 0.12);
      color: var(--primary);
    }

    /* Modern Redesigned Auth Card for Verified Members */
    .auth-card-active {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 16px 22px;
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid rgba(0, 42, 50, 0.08);
      box-shadow: 0 16px 36px rgba(0, 42, 50, 0.18), 0 4px 12px rgba(0, 42, 50, 0.06);
    }

    .auth-profile-block {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1 1 0;
      min-width: 0;
    }

    .auth-card-active .auth-card-right {
      flex: 1 1 0;
      display: flex;
      justify-content: flex-end;
      align-items: center;
    }

    .auth-avatar-rel {
      position: relative;
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }

    .auth-avatar-rel img {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      object-fit: cover;
      display: block;
      border: 2px solid rgba(0, 42, 50, 0.1);
      box-shadow: 0 4px 10px rgba(0, 42, 50, 0.12);
    }

    .avatar-dot-online {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: #10b981;
      border: 2px solid #ffffff;
      box-shadow: 0 0 4px rgba(16, 185, 129, 0.8);
    }

    .auth-user-info {
      display: flex;
      flex-direction: column;
      gap: 5px;
      min-width: 0;
    }

    .auth-user-top-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .auth-user-name {
      font-size: 16.5px;
      font-weight: 800;
      color: var(--dark-nero);
      letter-spacing: -0.2px;
    }

    .auth-badge-verified {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 700;
      background: #ecfdf5;
      color: #059669;
      border: 1px solid #a7f3d0;
    }

    .auth-servers-tags-row {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .auth-server-mini-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 700;
      color: #334155;
      background: #f1f5f9;
      padding: 2px 8px;
      border-radius: 8px;
      border: 1px solid rgba(0, 42, 50, 0.08);
    }
    .auth-server-mini-tag svg {
      color: #10b981;
    }

    /* Modern Power Widget in Center */
    .auth-power-container {
      flex: 0 1 auto;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      border: 1px solid rgba(0, 42, 50, 0.08);
      padding: 9px 18px;
      border-radius: 14px;
      box-shadow: 0 2px 10px rgba(0, 42, 50, 0.04);
      text-align: center;
    }

    .power-counter-box {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .power-score-circle {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: linear-gradient(135deg, #ff595e 0%, #e0484d 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 800;
      box-shadow: 0 3px 10px rgba(255, 89, 94, 0.35);
      flex-shrink: 0;
    }

    .power-text-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      line-height: 1.15;
    }

    .power-text-title {
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: 0.7px;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .power-text-val {
      font-size: 13.5px;
      font-weight: 800;
      color: var(--dark-nero);
    }

    .power-chips-list {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .p-pill {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 8px;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
      box-shadow: 0 1px 2px rgba(0, 42, 50, 0.04);
    }
    .p-pill:hover {
      transform: translateY(-1px);
    }

    .p-pill-base {
      background: #ffffff;
      color: #475569;
      border: 1px solid #cbd5e1;
    }

    .p-pill-server {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }
    .p-pill-server svg {
      color: #2563eb;
    }

    .p-pill-boost {
      background: #fdf2f8;
      color: #be185d;
      border: 1px solid #fbcfe8;
      font-weight: 800;
      box-shadow: 0 1px 4px rgba(190, 24, 93, 0.12);
    }
    .p-pill-boost svg {
      color: #ec4899;
    }

    .auth-voted-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11.5px;
      font-weight: 700;
      color: #15803d;
      background: #dcfce7;
      border: 1px solid #86efac;
      padding: 3px 8px;
      border-radius: 8px;
    }

    .btn-disconnect-modern {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 14px;
      font-size: 12.5px;
      font-weight: 700;
      color: #64748b;
      background: #f8fafc;
      border: 1px solid rgba(0, 42, 50, 0.1);
      text-decoration: none;
      transition: all 0.15s ease;
      white-space: nowrap;
      font-family: inherit;
    }
    .btn-disconnect-modern:hover {
      background: #fee2e2;
      color: #dc2626;
      border-color: #fca5a5;
      transform: translateY(-1px);
    }

    @media (max-width: 900px) {
      .auth-card-active {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 14px;
      }
      .auth-profile-block {
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .auth-user-info {
        align-items: center;
      }
      .auth-servers-tags-row {
        justify-content: center;
      }
      .auth-card-right {
        justify-content: center;
        width: 100%;
      }
      .auth-power-container {
        width: 100%;
        max-width: 480px;
      }
    }

    @media (max-width: 768px) {
      .auth-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 16px;
      }
      .auth-card-left {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 12px;
      }
      .auth-info-col {
        text-align: center;
      }
      .auth-card-row {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 14px;
      }
      .auth-card-right {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin: 0 auto;
      }
      .btn-discord-login {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        width: auto;
        max-width: 100%;
      }
      .hero-title { font-size: 28px; }
      .server-grid { grid-template-columns: 1fr; }
      .prize-box { flex-direction: column; text-align: center; }
      .server-banner-header { height: 120px; padding: 12px; }
      .banner-rank-badge { top: 12px; right: 12px; }
      .server-icon-wrap { width: 50px; height: 50px; }
      .server-name { font-size: 16px; }
      .banner-content { padding-right: 70px; gap: 10px; }
    }
  </style>
</head>
<body>

  <div class="container">

    <!-- Auth Error Alert Banner (if present) -->
    <% if (authError) { %>
      <div class="alert-banner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Accesso con Discord non completato. Riprova effettuando il login con il pulsante dedicato.</span>
      </div>
    <% } %>

    <!-- Sezione Superiore: Community Partner (RoomUp, Strange Place, Groove Street) -->
    <div class="affiliate-showcase-section">
      <div class="affiliate-showcase-header">
        <h2 class="affiliate-showcase-title">Community Partner</h2>
        <p class="affiliate-showcase-subtitle">Per partecipare alle votazioni dell'evento devi far parte di almeno uno dei seguenti server:</p>
      </div>

      <div class="affiliate-showcase-grid">
        <% (affiliateCards || []).forEach(card => { %>
          <div class="affiliate-showcase-card <%= card.isUserMember ? 'card-is-member' : '' %>">
            <div class="aff-card-left">
              <div class="aff-icon-wrap">
                <img src="<%= card.icon %>" alt="<%= card.name %> icon" class="aff-icon-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="aff-icon-fallback" style="display: none;">
                  <%= card.name.charAt(0).toUpperCase() %>
                </div>
              </div>
              <div class="aff-info-col">
                <div class="aff-name"><%= card.name %></div>
                <div class="aff-meta">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                  <span><%= (card.memberCount || 0).toLocaleString('it-IT') %> membri</span>
                </div>
              </div>
            </div>

            <div class="aff-card-right">
              <% if (card.isUserMember) { %>
                <div class="aff-pill-joined">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>Presente</span>
                </div>
              <% } else { %>
                <a href="<%= card.inviteUrl %>" target="_blank" rel="noopener noreferrer" class="btn-aff-enter" title="Entra in <%= card.name %>">
                  <span>Entra nel Server</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7"/>
                    <path d="M7 7h10v10"/>
                  </svg>
                </a>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Discord Authentication Bar -->
    <div class="auth-container" id="authSection">
      <% if (!discordUser) { %>
        <!-- Stato 1: Non Autenticato (Accesso Obbligatorio) -->
        <div class="auth-card">
          <div class="auth-card-left">
            <div class="auth-icon-badge">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </div>
            <div class="auth-info-col">
              <div class="auth-title">Accesso Obbligatorio per Votare</div>
              <div class="auth-desc">Per votare per il tuo server preferito devi accedere con Discord ed essere membro di almeno uno dei server partner (RoomUp, Strange Place o Groove Streets).</div>
            </div>
          </div>
          <div class="auth-card-right">
            <a href="/api/evento/discord/login" class="btn-discord-login">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              <span>Accedi con Discord</span>
            </a>
          </div>
        </div>

      <% } else if (discordUser.isMember) { %>
        <!-- Stato 2: Autenticato e Membro Verificato -->
        <div class="auth-card auth-card-active">
          <!-- Profilo Utente & Tag Server -->
          <div class="auth-profile-block">
            <div class="auth-avatar-rel">
              <img src="<%= discordUser.avatar %>" alt="<%= discordUser.username %>">
              <div class="avatar-dot-online" title="Connesso con Discord"></div>
            </div>
            <div class="auth-user-info">
              <div class="auth-user-top-row">
                <span class="auth-user-name"><%= discordUser.username %></span>
                <% if (userVote) { %>
                  <span class="auth-voted-pill">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Votato: <%= userVote.serverName %> (<%= userVote.points || 1 %> pt)</span>
                  </span>
                <% } %>
              </div>
              <div class="auth-servers-tags-row">
                <% (discordUser.memberGuilds || []).forEach(name => { %>
                  <span class="auth-server-mini-tag">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span><%= name.toLowerCase().includes('roomup') ? 'RoomUp!' : name.replace(/TEST/gi, '').trim() %></span>
                  </span>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Counter Punteggio / Valore del Voto con Chips Centrato e Rifinito -->
          <% if (votingPower) { %>
            <div class="auth-power-container">
              <div class="power-counter-box">
                <div class="power-score-circle"><%= votingPower.total %></div>
                <div class="power-text-col">
                  <span class="power-text-title">Valore Voto</span>
                  <span class="power-text-val"><%= votingPower.total %> <%= votingPower.total === 1 ? 'Punto' : 'Punti' %></span>
                </div>
              </div>
              <div class="power-chips-list">
                <span class="p-pill p-pill-base" title="Punteggio base di voto">1 Base</span>
                <% if (votingPower.memberRoomUp) { %>
                  <span class="p-pill p-pill-server" title="Presenza verificata in RoomUp!">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>+3 RoomUp</span>
                  </span>
                <% } %>
                <% if (votingPower.memberStrange) { %>
                  <span class="p-pill p-pill-server" title="Presenza verificata in Strange Place">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>+2 Strange</span>
                  </span>
                <% } %>
                <% if (votingPower.memberGroove) { %>
                  <span class="p-pill p-pill-server" title="Presenza verificata in Groove Streets">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>+1 Groove</span>
                  </span>
                <% } %>
                <% if (votingPower.boostGroove) { %>
                  <span class="p-pill p-pill-boost" title="<%= votingPower.boostGrooveCount || 1 %> Server Boost su Groove Streets (<%= votingPower.boostGroove %> pt)">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span>+<%= votingPower.boostGroove %> Boost Groove<%= (votingPower.boostGrooveCount > 1) ? ' (' + votingPower.boostGrooveCount + ' boost)' : '' %></span>
                  </span>
                <% } %>
                <% if (votingPower.boostStrange) { %>
                  <span class="p-pill p-pill-boost" title="<%= votingPower.boostStrangeCount || 1 %> Server Boost su Strange Place (<%= votingPower.boostStrange %> pt)">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span>+<%= votingPower.boostStrange %> Boost Strange<%= (votingPower.boostStrangeCount > 1) ? ' (' + votingPower.boostStrangeCount + ' boost)' : '' %></span>
                  </span>
                <% } %>
                <% if (votingPower.boostRoomUp) { %>
                  <span class="p-pill p-pill-boost" title="<%= votingPower.boostRoomUpCount || 1 %> Server Boost su RoomUp! (<%= votingPower.boostRoomUp %> pt)">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span>+<%= votingPower.boostRoomUp %> Boost RoomUp<%= (votingPower.boostRoomUpCount > 1) ? ' (' + votingPower.boostRoomUpCount + ' boost)' : '' %></span>
                  </span>
                <% } %>
              </div>
            </div>
          <% } %>

          <!-- Pulsante Disconnetti -->
          <div class="auth-card-right">
            <a href="/api/evento/discord/logout" class="btn-disconnect-modern" title="Disconnetti account">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>Disconnetti</span>
            </a>
          </div>
        </div>

      <% } else { %>
        <!-- Stato 3: Autenticato ma NON Membro dei Server Partner -->
        <div class="auth-card">
          <div class="auth-card-top-layout">
            <div class="auth-card-row">
              <div class="auth-card-left">
                <div class="auth-avatar-wrap">
                  <img src="<%= discordUser.avatar %>" alt="<%= discordUser.username %>" class="auth-avatar-img">
                </div>
                <div class="auth-info-col">
                  <div class="auth-user-header">
                    <span class="auth-username"><%= discordUser.username %></span>
                    <span class="auth-status-pill status-warning">
                      <span class="status-dot status-dot-red"></span>
                      Accesso Non Abilitato
                    </span>
                  </div>
                  <div class="auth-desc">
                    Non risulti attualmente membro di nessuno dei 3 server partner. Entra in almeno uno dei server sottostanti per abilitare il tuo voto.
                  </div>
                </div>
              </div>
              <div class="auth-card-right">
                <a href="/api/evento/discord/refresh" class="btn-action-outline btn-refresh" title="Ricontrolla appartenenza ai server">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                    <path d="M3 3v5h5"/>
                    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
                    <path d="M16 21h5v-5"/>
                  </svg>
                  <span>Verifica di nuovo</span>
                </a>
                <a href="/api/evento/discord/logout" class="btn-action-outline">
                  <span>Disconnetti</span>
                </a>
              </div>
            </div>

            <!-- Griglia dei 3 Server Partner con pulsante Entra -->
            <div class="affiliate-section">
              <div class="affiliate-title">Server partner richiesti per il voto (unisciti ad almeno uno):</div>
              <div class="affiliate-grid">
                <% (affiliateServers || []).forEach(aff => { %>
                  <div class="affiliate-card">
                    <span class="affiliate-name" title="<%= aff.name %>"><%= aff.name %></span>
                    <a href="<%= aff.inviteUrl %>" target="_blank" rel="noopener noreferrer" class="btn-affiliate-enter">
                      <span>Entra</span>
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17 17 7"/>
                        <path d="M7 7h10v10"/>
                      </svg>
                    </a>
                  </div>
                <% }); %>
              </div>
            </div>

          </div>
        </div>
      <% } %>
    </div>

    <!-- Sistema di Punteggio dei Voti -->
    <div class="points-rule-section">
      <div class="points-rule-header">
        <div class="points-rule-title-wrap">
          <div class="points-rule-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h2 class="points-rule-title">Sistema di Punteggio</h2>
        </div>
        <div class="points-rule-base-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>1 Reazione / Voto = 1 Punto Base</span>
        </div>
      </div>
      <p class="points-rule-desc">
        Ogni reazione/voto standard assegna 1 punto base al server selezionato. Se sei membro dei seguenti server partner o hai effettuato un boost, il valore del tuo voto aumenta:
      </p>

      <div class="points-grid">
        <div class="points-card">
          <div class="points-card-header">
            <span class="points-card-name">Groove Streets</span>
          </div>
          <div class="points-row">
            <span class="points-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Membro del Server
            </span>
            <span class="points-val">+1 Punto</span>
          </div>
          <div class="points-row">
            <span class="points-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Ogni Boost
            </span>
            <span class="points-val">+3 Punti</span>
          </div>
        </div>

        <div class="points-card">
          <div class="points-card-header">
            <span class="points-card-name">Strange Place</span>
          </div>
          <div class="points-row">
            <span class="points-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Membro del Server
            </span>
            <span class="points-val">+2 Punti</span>
          </div>
          <div class="points-row">
            <span class="points-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Ogni Boost
            </span>
            <span class="points-val">+2 Punti</span>
          </div>
        </div>

        <div class="points-card">
          <div class="points-card-header">
            <span class="points-card-name">RoomUp!</span>
          </div>
          <div class="points-row">
            <span class="points-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Membro del Server
            </span>
            <span class="points-val">+3 Punti</span>
          </div>
          <div class="points-row">
            <span class="points-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Ogni Boost
            </span>
            <span class="points-val">+1 Punto</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Hero Header -->
    <div class="hero">
      <% if (settings.status === 'active') { %>
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Votazioni Aperte</span>
        </div>
      <% } else if (settings.status === 'paused') { %>
        <div class="hero-badge badge-paused">
          <span class="badge-dot"></span>
          <span>Votazioni in Pausa</span>
        </div>
      <% } else { %>
        <div class="hero-badge badge-ended">
          <span class="badge-dot"></span>
          <span>Evento Terminato</span>
        </div>
      <% } %>

      <h1 class="hero-title"><%= settings.title %></h1>
      <p class="hero-desc"><%= settings.description %></p>

      <% if (settings.prize) { %>
        <div class="prize-box">
          <div class="prize-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);">
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
              <path d="M4 22h16"/>
              <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            </svg>
          </div>
          <div>
            <div class="prize-title">Premio in Palio</div>
            <div class="prize-text"><%= settings.prize %></div>
          </div>
        </div>
      <% } %>

      <!-- Box Scadenza e Countdown (Termine: 21 Settembre alle 00:00) -->
      <div class="countdown-widget" id="eventCountdown">
        <div class="countdown-head">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>Termine Votazioni: <strong>21 Settembre alle 00:00</strong></span>
        </div>
        <div class="countdown-grid" id="countdownGrid">
          <div class="cd-box"><span class="cd-val" id="cd-days">--</span><span class="cd-lbl">Giorni</span></div>
          <span class="cd-colon">:</span>
          <div class="cd-box"><span class="cd-val" id="cd-hours">--</span><span class="cd-lbl">Ore</span></div>
          <span class="cd-colon">:</span>
          <div class="cd-box"><span class="cd-val" id="cd-mins">--</span><span class="cd-lbl">Minuti</span></div>
          <span class="cd-colon">:</span>
          <div class="cd-box"><span class="cd-val" id="cd-secs">--</span><span class="cd-lbl">Secondi</span></div>
        </div>
      </div>

      <div class="stats-bar">
        <div class="stat-pill"><strong><%= servers.length %></strong> Server in Gara</div>
        <div class="stat-pill"><strong id="stat-total-votes"><%= totalVotes %></strong> Punti Assegnati</div>
        <div class="stat-pill">Regola: <strong>1 Solo Server per Account</strong></div>
      </div>
    </div>

    <!-- Server List -->
    <% if (servers.length === 0) { %>
      <div class="empty-state">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary); margin-bottom: 12px;">
          <rect width="20" height="12" x="2" y="6" rx="2"/>
          <path d="M12 12h.01"/>
          <path d="M17 12h.01"/>
          <path d="M7 12h.01"/>
        </svg>
        <h3 style="color: var(--dark-nero); margin-bottom: 6px;">Nessun server in gara al momento</h3>
        <p>I server verranno aggiunti presto dall'amministratore dell'evento.</p>
      </div>
    <% } else { %>
      <div class="server-grid" id="serverGrid">
        <% servers.forEach((server, index) => { %>
          <div class="server-card" id="card-<%= server.id %>">
            
            <!-- Server Banner Header -->
            <div class="server-banner-header">
              <!-- Background Banner Image or Fallback -->
              <% if (server.banner) { %>
                <img src="<%= server.banner %>" alt="<%= server.name %> banner" class="banner-bg-img" onerror="this.style.display='none';">
              <% } else if (server.icon && !server.icon.includes('youtube.com')) { %>
                <img src="<%= server.icon %>" alt="<%= server.name %> banner" class="banner-bg-img banner-bg-blur" onerror="this.style.display='none';">
              <% } %>
              <div class="banner-overlay"></div>

              <!-- Top-Right Rank Badge inside Banner -->
              <div class="banner-rank-badge">
                <% if (index === 0) { %>
                  <span class="rank-pill rank-1">1° Posto</span>
                <% } else if (index === 1) { %>
                  <span class="rank-pill rank-2">2° Posto</span>
                <% } else if (index === 2) { %>
                  <span class="rank-pill rank-3">3° Posto</span>
                <% } else { %>
                  <span class="rank-pill rank-other">#<%= index + 1 %></span>
                <% } %>
              </div>

              <!-- Content: Immagine Server (Left) + Nome Server (Center) -->
              <div class="banner-content">
                <div class="server-icon-wrap">
                  <% if (server.icon && !server.icon.includes('youtube.com')) { %>
                    <img 
                      src="<%= server.icon %>" 
                      alt="<%= server.name %> icon" 
                      class="server-icon-img" 
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="server-icon-fallback" style="display: none;">
                      <%= server.name.charAt(0).toUpperCase() %>
                    </div>
                  <% } else { %>
                    <div class="server-icon-fallback">
                      <%= server.name.charAt(0).toUpperCase() %>
                    </div>
                  <% } %>
                </div>

                <div class="server-info-col">
                  <div class="server-name" title="<%= server.name %>"><%= server.name %></div>
                </div>
              </div>

            </div>

            <!-- Description (if present) -->
            <% if (server.description && server.description.trim()) { %>
              <div class="server-desc">
                <%= server.description %>
              </div>
            <% } %>

            <!-- Bottom Row: Buttons -->
            <div class="server-actions">
              <% if (userVote) { %>
                <% if (userVote.serverId === server.id) { %>
                  <button 
                    class="btn-vote btn-vote-voted" 
                    id="btn-vote-<%= server.id %>"
                    disabled
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>Votato</span>
                    <span class="vote-chip" id="votes-<%= server.id %>"><%= server.votes || 0 %> <%= (server.votes || 0) === 1 ? 'punto' : 'punti' %></span>
                  </button>
                <% } else { %>
                  <button 
                    class="btn-vote btn-vote-disabled" 
                    id="btn-vote-<%= server.id %>"
                    disabled
                  >
                    <span>Voto già espresso</span>
                    <span class="vote-chip" id="votes-<%= server.id %>"><%= server.votes || 0 %> <%= (server.votes || 0) === 1 ? 'punto' : 'punti' %></span>
                  </button>
                <% } %>
              <% } else { %>
                <button 
                  class="btn-vote" 
                  id="btn-vote-<%= server.id %>"
                  onclick="handleVoteClick('<%= server.id %>')"
                  <%= settings.status !== 'active' ? 'disabled' : '' %>
                >
                  <span>Vota</span>
                  <span class="vote-chip" id="votes-<%= server.id %>"><%= server.votes || 0 %> <%= (server.votes || 0) === 1 ? 'punto' : 'punti' %></span>
                </button>
              <% } %>

              <% if (server.inviteUrl) { %>
                <a href="<%= server.inviteUrl %>" target="_blank" rel="noopener noreferrer" class="btn-join" title="Entra nel Server">
                  <span>Entra</span>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7"/>
                    <path d="M7 7h10v10"/>
                  </svg>
                </a>
              <% } %>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

  <div id="toast"></div>

  <footer>
    Linea Temporale • Evento Votazioni Server &copy; <%= new Date().getFullYear() %>
  </footer>

  <script>
    const userLoggedIn = <%= Boolean(discordUser) %>;
    const userIsMember = <%= Boolean(discordUser && discordUser.isMember) %>;
    let userHasVoted = <%= Boolean(userVote) %>;
    let isSubmitting = false;

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.className = type;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 4500);
    }

    function handleVoteClick(serverId) {
      if (!userLoggedIn) {
        showToast('Accesso richiesto: effettua il login con Discord per votare.', 'warning');
        const authEl = document.getElementById('authSection');
        if (authEl) {
          authEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      if (!userIsMember) {
        showToast('Devi essere membro di almeno uno dei server partner per votare.', 'error');
        const authEl = document.getElementById('authSection');
        if (authEl) {
          authEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      if (userHasVoted) {
        showToast('Hai già espresso il tuo voto per questo evento! È consentito solo 1 voto per account.', 'warning');
        return;
      }

      castVote(serverId);
    }

    async function castVote(serverId) {
      if (isSubmitting || userHasVoted) return;
      isSubmitting = true;

      const btn = document.getElementById(`btn-vote-${serverId}`);
      const oldHtml = btn.innerHTML;
      btn.innerHTML = '<span>Invio in corso...</span>';
      btn.disabled = true;

      try {
        const res = await fetch('/api/evento/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ serverId })
        });

        const data = await res.json();

        if (data.success) {
          showToast(data.message, 'success');
          userHasVoted = true;

          // Aggiorna totale punti in alto
          const pointsAdded = data.pointsAdded || 1;
          const totalEl = document.getElementById('stat-total-votes');
          if (totalEl) totalEl.textContent = parseInt(totalEl.textContent, 10) + pointsAdded;

          // Disabilita tutti i bottoni e imposta questo come Votato
          document.querySelectorAll('.btn-vote').forEach(b => {
            if (b.id === `btn-vote-${serverId}`) {
              b.className = 'btn-vote btn-vote-voted';
              b.disabled = true;
              b.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Votato</span><span class="vote-chip">${data.votes} ${data.votes === 1 ? 'punto' : 'punti'}</span>`;
            } else {
              b.className = 'btn-vote btn-vote-disabled';
              b.disabled = true;
              const chip = b.querySelector('.vote-chip');
              const votesText = chip ? chip.textContent : '';
              b.innerHTML = `<span>Voto già espresso</span><span class="vote-chip">${votesText}</span>`;
            }
          });
        } else {
          if (data.error === 'auth_required') {
            showToast('Accesso richiesto: effettua il login con Discord.', 'warning');
            window.location.href = '/api/evento/discord/login';
            return;
          } else if (data.error === 'not_member') {
            showToast('Devi essere membro di almeno uno dei server partner per votare.', 'error');
            const authEl = document.getElementById('authSection');
            if (authEl) authEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else if (data.error === 'already_voted') {
            userHasVoted = true;
            showToast(data.message, 'warning');
            setTimeout(() => { window.location.reload(); }, 1500);
          } else {
            showToast(data.message || 'Errore durante la votazione.', 'error');
          }
          btn.innerHTML = oldHtml;
        }
      } catch (err) {
        showToast('Errore di connessione. Riprova tra poco.', 'error');
        btn.innerHTML = oldHtml;
      } finally {
        btn.disabled = false;
        isSubmitting = false;
      }
    }

    // Countdown automatico con blocco votazioni al termine
    (function initCountdown() {
      const endTimestamp = <%= settings.endTimestamp || new Date(settings.endDate || '2026-09-21T00:00:00+02:00').getTime() %>;

      function tick() {
        const now = Date.now();
        const diff = endTimestamp - now;

        if (diff <= 0) {
          const grid = document.getElementById('countdownGrid');
          if (grid) {
            grid.innerHTML = '<div style="font-size: 13.5px; font-weight: 700; color: #ef4444; padding: 4px 0;">Evento concluso. Votazioni chiuse.</div>';
          }
          document.querySelectorAll('.btn-vote').forEach(b => {
            b.disabled = true;
            b.classList.add('btn-vote-disabled');
            b.innerHTML = '<span>Votazioni Chiuse</span>';
          });
          return;
        }

        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const m = Math.floor((diff / (1000 * 60)) % 60);
        const s = Math.floor((diff / 1000) % 60);

        const elD = document.getElementById('cd-days');
        const elH = document.getElementById('cd-hours');
        const elM = document.getElementById('cd-mins');
        const elS = document.getElementById('cd-secs');

        if (elD) elD.textContent = String(d).padStart(2, '0');
        if (elH) elH.textContent = String(h).padStart(2, '0');
        if (elM) elM.textContent = String(m).padStart(2, '0');
        if (elS) elS.textContent = String(s).padStart(2, '0');
      }

      tick();
      setInterval(tick, 1000);
    })();
  </script>
</body>
</html>
