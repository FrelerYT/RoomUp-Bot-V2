    async function submitAddKnowledge() {
      const title = document.getElementById('sentinelKbTitle')?.value?.trim();
      const category = document.getElementById('sentinelKbCategory')?.value || 'SERVER_FAQ';
      const content = document.getElementById('sentinelKbContent')?.value?.trim();
      const keywordsRaw = document.getElementById('sentinelKbKeywords')?.value || '';
      const keywords = keywordsRaw.split(',').map(k => k.trim()).filter(Boolean);

      if (!title || !content) {
        showToast('Titolo e contenuto sono obbligatori!', true);
        return;
      }

      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/knowledge`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, category, content, keywords, source: 'dashboard' })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Documento aggiunto alla Knowledge Base!');
          closeAddKnowledgeModal();
          document.getElementById('sentinelKbTitle').value = '';
          document.getElementById('sentinelKbContent').value = '';
          document.getElementById('sentinelKbKeywords').value = '';
          await loadSentinelKnowledge();
        } else {
          showToast(data.message || 'Errore salvataggio documento', true);
        }
      } catch (err) {
        showToast('Errore di connessione: ' + err.message, true);
      }
    }

    async function rollbackSentinelKnowledge(id, currentVersion) {
      const targetVersion = prompt(`Inserisci la versione a cui effettuare il rollback (attuale: v${currentVersion}):`, Math.max(1, currentVersion - 1));
      if (!targetVersion) return;

      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/knowledge/${id}/rollback`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetVersion: Number(targetVersion) })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message || 'Rollback effettuato con successo!');
          await loadSentinelKnowledge();
        } else {
          showToast(data.message || 'Errore rollback', true);
        }
      } catch (err) {
        showToast('Errore: ' + err.message, true);
      }
    }

