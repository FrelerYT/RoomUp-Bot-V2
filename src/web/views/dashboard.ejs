    /* Category & Events Matrix */
    .master-controls { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--card-radius); padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .search-box { position: relative; flex: 1; min-width: 250px; }
    .search-box i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-dim); font-size: 0.9rem; }
    .search-input { width: 100%; height: 40px; padding: 0 1rem 0 2.5rem; background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--control-radius); color: var(--text-main); font-size: 0.88rem; font-weight: 500; outline: none; }
    .search-input:focus { border-color: #5865F2; }

    .category-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--card-radius); margin-bottom: 1.25rem; overflow: hidden; }
    .category-header { background: rgba(0,0,0,0.2); padding: 0.9rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .category-header-title { display: flex; align-items: center; gap: 0.75rem; font-size: 0.88rem; font-weight: 800; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.5px; }
    .category-header-actions { display: flex; align-items: center; gap: 0.85rem; }

    .events-container { display: flex; flex-direction: column; }
    .event-wrapper { border-bottom: 1px solid var(--border); }
    .event-wrapper:last-child { border-bottom: none; }
    .event-row { padding: 0.9rem 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; }
    .event-meta h4 { font-size: 0.9rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.15rem; }
    .event-meta p { font-size: 0.78rem; color: var(--text-muted); }
    .event-controls { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
    .btn-gear { background: var(--bg-input); border: 1px solid var(--border); color: var(--text-dim); width: 34px; height: 34px; border-radius: var(--control-radius); cursor: pointer; transition: all 0.15s; display: flex; align-items: center; justify-content: center; }
    .btn-gear:hover { color: var(--text-main); border-color: var(--border-hover); }
    .event-custom-panel { display: none; padding: 1.15rem 1.25rem; background: rgba(0,0,0,0.22); border-top: 1px solid var(--border); }

    /* Tables */
    .data-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem; }
    .data-table th { background: rgba(0,0,0,0.25); padding: 0.8rem 1.15rem; font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: var(--text-dim); border-bottom: 1px solid var(--border); }
    .data-table td { padding: 0.9rem 1.15rem; border-bottom: 1px solid var(--border); color: var(--text-main); font-weight: 500; vertical-align: middle; }
    .data-table tr:last-child td { border-bottom: none; }

    /* Action buttons */
    .btn-action { background: rgba(255, 255, 255, 0.04); color: var(--text-main); border: 1px solid var(--border); height: 38px; padding: 0 1.15rem; border-radius: var(--control-radius); font-weight: 700; font-size: 0.82rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; transition: all 0.15s ease; text-decoration: none; box-sizing: border-box; }
    .btn-action:hover { background: rgba(255, 255, 255, 0.08); border-color: var(--border-hover); }
    .btn-danger { background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25); height: 36px; padding: 0 0.85rem; border-radius: var(--control-radius); font-weight: 700; font-size: 0.8rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; transition: all 0.15s; box-sizing: border-box; }
    .btn-danger:hover { background: var(--accent-red); color: #fff; }

    /* Floating Save Bar */
    .floating-save-bar {
      position: fixed;
      bottom: -90px;
      left: 50%;
      transform: translateX(-50%);
      width: min(860px, 92vw);
      background: #14151b;
      border: 1px solid var(--border);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
      border-radius: var(--card-radius);
      padding: 0.85rem 1.35rem;
      z-index: 2500;
      transition: bottom 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .floating-save-bar.visible {
      bottom: 24px;
    }
    .floating-save-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .floating-save-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.88rem;
      color: var(--text-main);
      font-weight: 600;
    }
    .floating-save-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 3000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal-overlay.open {
      display: flex;
      animation: modalFadeIn 0.15s ease;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.98); }
      to { opacity: 1; transform: scale(1); }
    }
    .modal-card {
      background: #18191f;
      border: 1px solid var(--border);
      border-radius: 16px;
      width: min(500px, 95vw);
      padding: 1.6rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
