              http://localhost:3002/api/webhook/github/<%= guildId %>
            </code>
            <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.35rem;">Incolla questo indirizzo nei Webhook di GitHub per ricevere notifiche su commit e release.</div>
          </div>
        </div>
      </div>

