                <input type="text" id="countColorHex" class="form-control form-control-mono" value="<%= config.counting?.embedColor || '#5865F2' %>" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('countColor').value = this.value;} markUnsavedChanges();">
              </div>
