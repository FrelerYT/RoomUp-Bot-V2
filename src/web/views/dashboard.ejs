          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-plus"></i> Nuovo Comando</div>
              <div class="card-desc">Imposta una risposta automatica quando viene inviato un comando.</div>
            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Comando o Parola Chiave:</label>
              <input type="text" id="newCmdTrigger" class="form-control" placeholder="Es. !ip, !regole, !social">
            </div>
            <div class="form-group">
              <label class="form-label">Titolo (Opzionale):</label>
              <input type="text" id="newCmdTitle" class="form-control" placeholder="Es. Indirizzo Server">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Risposta del Bot:</label>
            <textarea id="newCmdResponse" class="form-control" placeholder="Inserisci il messaggio che il bot invierà in chat..."></textarea>
          </div>

          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
            <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 700;">
              <input type="checkbox" id="newCmdEmbed" style="accent-color: var(--primary); width: 18px; height: 18px;">
              <span>Invia come embed colorato</span>
            </label>
            <button type="button" class="btn-action" onclick="addCustomCommand()"><i class="fa-solid fa-plus"></i> Salva Comando</button>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-terminal"></i> Comandi Attivi</div>
              <div class="card-desc">Tutti i comandi personalizzati configurati sul server.</div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Comando</th>
                  <th>Risposta</th>
                  <th>Formato</th>
                  <th style="text-align: right;">Azioni</th>
                </tr>
              </thead>
              <tbody id="customCommandsTableBody">
                <% const cmdList = ((config.customCommands?.triggers) || []); %>
                <% if (cmdList.length === 0) { %>
                  <tr id="noCustomCmdRow">
                    <td colspan="4" class="empty-state">Nessun comando creato. Aggiungine uno con il modulo sopra.</td>
                  </tr>
                <% } else { %>
                  <% cmdList.forEach(cmd => { %>
                    <tr id="row_cmd_<%= cmd.id || cmd.trigger.replace(/[^a-zA-Z0-9]/g, '_') %>">
                      <td><code><%= cmd.trigger %></code></td>
                      <td><%= cmd.response %></td>
                      <td><span style="color: var(--primary); font-weight: 800;"><%= cmd.useEmbed ? 'EMBED' : 'TESTO' %></span></td>
                      <td style="text-align: right;">
                        <button type="button" class="btn-danger" onclick="deleteCustomCommand('<%= cmd.id || cmd.trigger %>')"><i class="fa-solid fa-trash"></i></button>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

