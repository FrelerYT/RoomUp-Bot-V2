                <input type="color" id="givStartColor" value="<%= config.giveaways?.startEmbedColor || '#5865F2' %>" class="color-picker-input" onchange="document.getElementById('givStartColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="givStartColorHex" class="form-control" value="<%= config.giveaways?.startEmbedColor || '#5865F2' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('givStartColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Titolo Embed Fine:</label>
              <input type="text" id="givEndTitle" class="form-control" value="<%= config.giveaways?.endEmbedTitle || 'GIVEAWAY CONCLUSO' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Barra Embed Fine:</label>
              <div class="color-picker-group">
                <input type="color" id="givEndColor" value="<%= config.giveaways?.endEmbedColor || '#5865F2' %>" class="color-picker-input" onchange="document.getElementById('givEndColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="givEndColorHex" class="form-control" value="<%= config.giveaways?.endEmbedColor || '#5865F2' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('givEndColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Messaggio Annuncio Vincitore (nel Canale):</label>
              <input type="text" id="givWinMessage" class="form-control" value="<%= config.giveaways?.winMessage || 'Congratulazioni {winners}! Hai vinto **{prize}**!' %>" oninput="markUnsavedChanges()">
              <div style="margin-top: 0.3rem;">
                <span class="var-chip" onclick="insertVar('givWinMessage', '{winners}')">{winners}</span>
                <span class="var-chip" onclick="insertVar('givWinMessage', '{prize}')">{prize}</span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Messaggio Diretto al Vincitore (DM):</label>
              <input type="text" id="givWinnerDm" class="form-control" value="<%= config.giveaways?.dmWinnerMessage || 'Complimenti! Hai vinto **{prize}** nel server **{guild}**! Contatta lo staff per riscattarlo.' %>" oninput="markUnsavedChanges()">
              <div style="margin-top: 0.3rem;">
                <span class="var-chip" onclick="insertVar('givWinnerDm', '{prize}')">{prize}</span>
                <span class="var-chip" onclick="insertVar('givWinnerDm', '{guild}')">{guild}</span>
              </div>
            </div>
          </div>

          <div class="grid-3" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Testo Footer Embed Giveaway:</label>
              <input type="text" id="givStartFooter" class="form-control" value="<%= config.giveaways?.startEmbedFooter || 'Reagisci o clicca per partecipare! • Termina' %>" oninput="markUnsavedChanges()">
            </div>
            <div class="form-group">
              <label class="form-label">URL Icona / Thumbnail:</label>
              <input type="text" id="givThumb" class="form-control" placeholder="https://i.imgur.com/... o vuoto" value="<%= config.giveaways?.thumbnail || '' %>" oninput="markUnsavedChanges()">
            </div>
            <div class="form-group">
              <label class="form-label">URL Banner Immagine:</label>
              <input type="text" id="givBannerImage" class="form-control" placeholder="https://i.imgur.com/... o vuoto" value="<%= config.giveaways?.bannerImage || '' %>" oninput="markUnsavedChanges()">
            </div>
          </div>
        </div>

        <!-- Active Giveaways List -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-list-check"></i> Giveaway del Server</div>
              <div class="card-desc">Elenco di tutti i giveaway attivi e conclusi.</div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Premio</th>
                  <th>Canale</th>
                  <th>Partecipanti</th>
                  <th>Vincitori</th>
                  <th>Stato</th>
                  <th>Scadenza</th>
                </tr>
              </thead>
              <tbody>
                <% if ((giveaways || []).length === 0) { %>
                  <tr>
                    <td colspan="6" class="empty-state">Nessun giveaway attivo al momento. Avviane uno con il comando slash <code>/giveaway-start</code> su Discord!</td>
                  </tr>
                <% } else { %>
                  <% giveaways.slice().reverse().forEach(g => { %>
                    <tr>
                      <td><strong><i class="fa-solid fa-gift" style="color: var(--accent-red); margin-right: 6px;"></i><%= g.prize %></strong></td>
                      <td><#<%= g.channelId %>></td>
                      <td><strong><%= (g.participants || []).length %></strong> iscritti</td>
                      <td><%= g.winnersCount %></td>
                      <td>
                        <% if (g.ended) { %>
                          <span class="badge-tag red">TERMINATO</span>
                        <% } else { %>
                          <span class="badge-tag green">IN CORSO</span>
                        <% } %>
                      </td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(g.endsAt).toLocaleString('it-IT') %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: SUGGESTIONS ================= -->
      <div id="tab-suggestions" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-lightbulb"></i>
            </div>
            <div>
              <h2 class="sub-title">Suggerimenti & Feedback Community</h2>
              <p class="sub-desc">Canale idee, approvazioni dello staff, reazioni automatiche e notifiche in DM agli autori.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-sliders"></i> Impostazioni & Automazioni</div>
              <div class="card-desc">Canale in cui vengono pubblicate le idee con il comando <code>/suggest</code>.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="sugEnabled" <%= config.suggestions?.enabled ? 'checked' : '' %> onchange="markUnsavedChanges()">
              <span class="slider"></span>
            </label>
          </div>

          <div class="grid-3" style="margin-bottom: 1.25rem;">
            <div class="setting-item-box">
              <div>
                <div class="setting-title">Reazioni Voto (👍 / 👎)</div>
                <div class="setting-desc">Aggiunge reazioni per votare la proposta</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="sugAllowVotes" <%= config.suggestions?.allowUpvoteDownvote ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Thread di Discussione</div>
                <div class="setting-desc">Crea un thread sotto ogni idea per discuterla</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="sugAutoThread" <%= config.suggestions?.autoCreateThread ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Notifica DM all'Autore</div>
                <div class="setting-desc">Avverte l'utente se l'idea viene approvata o rifiutata</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="sugDmStatus" <%= config.suggestions?.sendDmOnStatusChange ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Canale per i suggerimenti:</label>
              <select id="sugChannelId" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Seleziona canale --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.suggestions?.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Titolo Embed Proposta:</label>
              <input type="text" id="sugEmbedTitle" class="form-control" value="<%= config.suggestions?.embedTitle || 'Nuova Proposta' %>" oninput="markUnsavedChanges()">
            </div>
          </div>
        </div>

        <!-- SUGGESTIONS EMBED COLORS -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-palette"></i> Colori di Stato Embed Suggerimenti</div>
              <div class="card-desc">Personalizza il colore della barra laterale per ciascun stato del suggerimento.</div>
            </div>
          </div>

          <div class="grid-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Colore In Sospeso (Attesa):</label>
              <div class="color-picker-group">
                <input type="color" id="sugColor" value="<%= config.suggestions?.embedColor || '#f1c40f' %>" class="color-picker-input" onchange="document.getElementById('sugColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="sugColorHex" class="form-control" value="<%= config.suggestions?.embedColor || '#f1c40f' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('sugColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Colore Approvato:</label>
              <div class="color-picker-group">
                <input type="color" id="sugApprColor" value="<%= config.suggestions?.approvedColor || '#5865F2' %>" class="color-picker-input" onchange="document.getElementById('sugApprColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="sugApprColorHex" class="form-control" value="<%= config.suggestions?.approvedColor || '#5865F2' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('sugApprColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Colore Rifiutato:</label>
              <div class="color-picker-group">
                <input type="color" id="sugRejColor" value="<%= config.suggestions?.rejectedColor || '#e74c3c' %>" class="color-picker-input" onchange="document.getElementById('sugRejColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="sugRejColorHex" class="form-control" value="<%= config.suggestions?.rejectedColor || '#e74c3c' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('sugRejColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Colore In Lavorazione:</label>
              <div class="color-picker-group">
                <input type="color" id="sugProgColor" value="<%= config.suggestions?.inProgressColor || '#3498db' %>" class="color-picker-input" onchange="document.getElementById('sugProgColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="sugProgColorHex" class="form-control form-control-mono" value="<%= config.suggestions?.inProgressColor || '#3498db' %>" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('sugProgColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Testo Footer Embed Suggerimento:</label>
              <input type="text" id="sugFooterText" class="form-control" value="<%= config.suggestions?.embedFooter || 'RoomUp! Community Suggestions • ID: {suggestionId}' %>" oninput="markUnsavedChanges()">
            </div>
            <div class="form-group">
              <label class="form-label">Template Corpo del Suggerimento:</label>
              <input type="text" id="sugSubmissionTemplate" class="form-control" value="<%= config.suggestions?.submissionTemplate || '💡 **Suggerimento:**\n{suggestion}\n\n*Vota qui sotto con le reazioni!*' %>" oninput="markUnsavedChanges()">
            </div>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-comments"></i> Proposte Ricevute</div>
              <div class="card-desc">Ultime idee inviate con i relativi voti.</div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Proposta</th>
                  <th>Autore</th>
                  <th>Favorevoli</th>
                  <th>Contrari</th>
                  <th>Stato</th>
                </tr>
              </thead>
              <tbody>
                <% if ((suggestions || []).length === 0) { %>
                  <tr>
                    <td colspan="5" class="empty-state">Nessun suggerimento inviato finora. Usa il comando slash <code>/suggest &lt;idea&gt;</code>!</td>
                  </tr>
                <% } else { %>
                  <% suggestions.slice().reverse().forEach(s => { %>
                    <tr>
                      <td>"<%= s.text %>"</td>
                      <td><@<%= s.authorId %>></td>
                      <td style="color: #5865F2; font-weight: 800;"><i class="fa-solid fa-thumbs-up" style="margin-right: 6px;"></i><%= (s.upvotes || []).length %></td>
                      <td style="color: var(--accent-red); font-weight: 800;"><i class="fa-solid fa-thumbs-down" style="margin-right: 6px;"></i><%= (s.downvotes || []).length %></td>
                      <td>
                        <span class="badge-tag blue">
                          <%= s.status.toUpperCase() %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: LEVELS & XP ================= -->
      <div id="tab-levels" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-trophy"></i>
            </div>
            <div>
              <h2 class="sub-title">Livelli, Esperienza & Rank</h2>
              <p class="sub-desc">Sistema XP per messaggi e vocale con moltiplicatori, ruoli ricompensa e banner personalizzabili.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-sliders"></i> Funzionalità & Meccaniche XP</div>
              <div class="card-desc">Attiva o disattiva individualmente ogni meccanica del sistema di livelli.</div>
