        <!-- Recent Infractions Ledger -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-book-skull"></i> Registro Sanzioni del Server</div>
              <div class="card-desc">Tutte le sanzioni applicate nel server.</div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Utente</th>
                  <th>Sanzione</th>
                  <th>Motivo</th>
                  <th>Moderatore</th>
                  <th>Data</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  const allInfMap = (typeof allInfractions !== 'undefined' && allInfractions) ? allInfractions : {};
                  const flatInfs = [];
                  for (const [uId, list] of Object.entries(allInfMap)) {
                    (list || []).forEach(item => flatInfs.push({ ...item, userId: uId }));
                  }
                %>
                <% if (flatInfs.length === 0) { %>
                  <tr>
                    <td colspan="5" class="empty-state">Nessuna sanzione registrata nel server.</td>
                  </tr>
                <% } else { %>
                  <% flatInfs.slice().reverse().slice(0, 15).forEach(inf => { %>
                    <tr>
                      <td><code><%= inf.userId %></code></td>
                      <td>
                        <span style="background: rgba(240,178,50,0.15); color: var(--accent-yellow); padding: 0.2rem 0.5rem; border-radius: 5px; font-weight: 800; font-size: 0.72rem;">
                          <%= (inf.type || 'warn').toUpperCase() %>
                        </span>
                      </td>
                      <td><strong><%= inf.reason %></strong></td>
                      <td><span style="color: var(--text-muted); font-size: 0.8rem;"><%= inf.moderatorTag %></span></td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(inf.timestamp).toLocaleDateString('it-IT') %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

