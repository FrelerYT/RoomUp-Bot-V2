      <% if (typeof hiddenTabs === 'undefined' || !hiddenTabs || !hiddenTabs.includes('tab-economy')) { %>
      <div id="tab-economy" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-coins"></i>
            </div>
            <div>
              <h2 class="sub-title">Economia della Community & Negozio Virtuale</h2>
              <p class="sub-desc">Sistema economico completo con stipendi (/work), ricompense giornaliere (/daily), classifiche e regolazione manuale saldi.</p>
