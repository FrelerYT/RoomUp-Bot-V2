              <div>
                <div class="setting-title">Annuncio Level Up</div>
                <div class="setting-desc">Invia notifica quando l'utente sale di livello</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="levAnnounce" <%= config.levels?.announceLevelUp ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Usa Embed Ricco</div>
                <div class="setting-desc">Invia notifica level up come card embed</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="levUseEmbed" <%= config.levels?.useEmbed ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Mostra Avatar Utente</div>
                <div class="setting-desc">Icona profilo dell'utente nell'annuncio</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="levThumb" <%= config.levels?.showThumbnail ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Ruoli Ricompensa</div>
                <div class="setting-desc">Assegna ruoli automatici per livello</div>
