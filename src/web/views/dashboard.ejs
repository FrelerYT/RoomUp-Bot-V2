      <div id="tab-cases" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div>
              <h2 class="sub-title">Registro Sanzioni & Cassaforte Prove</h2>
              <p class="sub-desc">Database centralizzato con ID univoci per ogni avvertimento, timeout, kick o ban, con tracciamento prove e audit.</p>
            </div>
          </div>
          <div class="sub-header-actions"><button type="button" class="btn-action" onclick="openNewCaseModal()"><i class="fa-solid fa-plus"></i> Registra Sanzione</button></div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-scale-balanced"></i> Sanzioni Recenti</div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Caso #</th>
                  <th>Utente Bersaglio</th>
                  <th>Azione</th>
                  <th>Moderatore</th>
                  <th>Motivazione</th>
                  <th>Stato</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody id="casesTableBody">
                <% if (typeof cases !== 'undefined' && Array.isArray(cases) && cases.length > 0) { %>
                  <% cases.forEach(c => { %>
                    <tr>
                      <td><strong>#<%= c.caseId %></strong></td>
                      <td><%= c.targetTag %> <span style="font-size: 0.75rem; color: var(--text-dim);">(<%= c.targetId %>)</span></td>
                      <td><span class="badge-tag red"><%= c.action %></span></td>
                      <td><%= c.moderatorTag %></td>
                      <td><%= c.reason %></td>
                      <td><span class="badge-tag <%= c.status === 'ACTIVE' ? 'yellow' : 'green' %>"><%= c.status %></span></td>
                      <td>
                        <% if (c.status === 'ACTIVE') { %>
                          <button type="button" class="btn-probot-secondary btn-sm" onclick="resolveCaseDirect('<%= c.caseId %>')" style="font-size: 0.72rem; padding: 0.2rem 0.5rem;"><i class="fa-solid fa-check"></i> Risolvi</button>
                        <% } else { %>
                          <span style="font-size: 0.72rem; color: var(--text-dim);">-</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="empty-state">Nessuna sanzione registrata nel database casi. Usa i comandi /warn, /timeout, /ban o il pulsante sopra.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: APPEALS & USER REPORTS ================= -->
      <div id="tab-appeals" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-gavel"></i>
            </div>
            <div>
              <h2 class="sub-title">Segnalazioni Utente & Ricorsi Disciplinari</h2>
              <p class="sub-desc">Gestisci le richieste di sban o revisione sanzioni inviate dagli utenti e le segnalazioni per comportamento scorretto.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-paper-plane"></i> Pubblica Pannello Ricorsi Sban</div>
          </div>
          <div class="card-desc">Invia l'interfaccia interattiva nel canale dedicato ai ricorsi per consentire agli utenti sanzionati di presentare domanda formale di sban.</div>
          <div style="display: flex; gap: 0.75rem; align-items: flex-end; margin-top: 1rem;">
            <div class="form-group" style="flex: 1;">
              <label class="form-label">Canale Ricorsi Unban:</label>
              <select id="unbanPanelChannelId" class="form-control">
                <option value="">-- Seleziona Canale --</option>
                <% textChannels.forEach(ch => { %>
                  <option value="<%= ch.id %>"># <%= ch.name %></option>
                <% }) %>
              </select>
            </div>
            <button type="button" class="btn-action" onclick="dispatchUnbanAppealPanel()"><i class="fa-solid fa-paper-plane"></i> Invia Pannello</button>
          </div>
        </div>

        <div class="dashboard-card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-flag"></i> Segnalazioni Ricevute (/report)</div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Segnalatore</th>
                  <th>Utente Segnalato</th>
                  <th>Motivo</th>
                  <th>Stato</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  const repList = (typeof reportsData !== 'undefined' && Array.isArray(reportsData?.reports)) ? reportsData.reports.filter(r => r.guildId === guildId) : [];
                  if (repList.length > 0) { 
                    repList.forEach(r => { 
                %>
                  <tr>
                    <td><code><%= r.id %></code></td>
                    <td><%= r.reporterTag %> <span style="font-size: 0.72rem; color: var(--text-dim);">(<%= r.reporterId %>)</span></td>
                    <td><strong><%= r.targetTag %></strong> <span style="font-size: 0.72rem; color: var(--text-dim);">(<%= r.targetId %>)</span></td>
                    <td style="max-width: 300px;"><%= r.reason %></td>
                    <td><span class="badge-tag <%= r.status === 'PENDING' ? 'yellow' : 'blue' %>"><%= r.status %></span></td>
                    <td>
                      <% if (r.status === 'PENDING') { %>
                        <button type="button" class="btn-probot-secondary btn-sm" onclick="dismissReportDirect('<%= r.id %>')" style="font-size: 0.72rem; padding: 0.2rem 0.5rem;"><i class="fa-solid fa-box-archive"></i> Archivia</button>
                      <% } else { %>
                        <span style="font-size: 0.72rem; color: var(--text-dim);"><%= r.status %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }); } else { %>
                  <tr>
                    <td colspan="6" class="empty-state">Nessuna segnalazione attiva per questo server.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-envelope-open"></i> Ricorsi Disciplinari Ricevuti</div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Utente</th>
                  <th>Tipo Sanzione</th>
                  <th>Motivo Ricorso</th>
                  <th>Stato</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  const appList = (typeof reportsData !== 'undefined' && Array.isArray(reportsData?.appeals)) ? reportsData.appeals.filter(a => a.guildId === guildId) : [];
                  if (appList.length > 0) { 
                    appList.forEach(a => { 
                %>
                  <tr>
                    <td><code><%= a.id %></code></td>
                    <td><strong><%= a.userTag %></strong> <span style="font-size: 0.72rem; color: var(--text-dim);">(<%= a.userId %>)</span></td>
                    <td><span class="badge-tag red"><%= a.actionType || 'BAN' %></span></td>
                    <td style="max-width: 300px;"><%= a.reason %></td>
                    <td><span class="badge-tag <%= a.status === 'PENDING' ? 'yellow' : (a.status === 'ACCEPTED' ? 'green' : 'red') %>"><%= a.status %></span></td>
                    <td>
                      <% if (a.status === 'PENDING') { %>
                        <button type="button" class="btn-probot-secondary btn-sm" onclick="resolveAppealDirect('<%= a.id %>', 'ACCEPTED')" style="color: #2ecc71; font-size: 0.72rem; padding: 0.2rem 0.5rem;"><i class="fa-solid fa-check"></i> Approva</button>
                        <button type="button" class="btn-probot-secondary btn-sm" onclick="resolveAppealDirect('<%= a.id %>', 'REJECTED')" style="color: #ef4444; font-size: 0.72rem; padding: 0.2rem 0.5rem;"><i class="fa-solid fa-xmark"></i> Respingi</button>
                      <% } else { %>
                        <span style="font-size: 0.72rem; color: var(--text-dim);"><%= a.status %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }); } else { %>
                  <tr>
                    <td colspan="6" class="empty-state">Nessun ricorso disciplinare registrato per questo server.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: MODMAIL HUB ================= -->
      <div id="tab-modmail" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-envelope-open-text"></i>
            </div>
            <div>
              <h2 class="sub-title">Hub Modmail Privato (DM Diretto Staff)</h2>
              <p class="sub-desc">Permette agli utenti di contattare lo Staff scrivendo direttamente in privato al bot, creando un thread dedicato nel server.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-sliders"></i> Impostazioni Modmail</div>
            <label class="switch">
              <input type="checkbox" id="modmail_enabled" <%= config.modmail?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Canale / Categoria Modmail:</label>
              <select id="modmail_categoryId" class="form-control">
                <option value="">-- Seleziona Canale o Categoria --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= config.modmail?.categoryId === cat.id ? 'selected' : '' %>>📂 <%= cat.name %></option>
                <% }) %>
                <% textChannels.forEach(ch => { %>
                  <option value="<%= ch.id %>" <%= config.modmail?.categoryId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Ruolo Notifica Staff:</label>
              <select id="modmail_staffRoleId" class="form-control">
                <option value="">-- Nessun Ruolo Notifica --</option>
                <% roles.forEach(r => { %>
                  <option value="<%= r.id %>" <%= config.modmail?.staffRoleId === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-inbox"></i> Sessioni Modmail Attive</div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID Utente</th>
                  <th>ID Thread Canale</th>
                  <th>Aperto Il</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  const activeSessions = Object.entries((typeof modmailSessions !== 'undefined' && modmailSessions?.sessions) ? modmailSessions.sessions : {}).filter(([uid, s]) => !s.guildId || s.guildId === guildId);
                  if (activeSessions.length > 0) { 
                    activeSessions.forEach(([uid, s]) => { 
                %>
                  <tr>
                    <td><code><%= uid %></code></td>
                    <td><code>#<%= s.threadId %></code></td>
                    <td><%= s.openedAt ? new Date(s.openedAt).toLocaleString("it-IT") : "-" %></td>
                    <td>
                      <button type="button" class="btn-probot-secondary btn-sm" onclick="closeModmailSessionDirect('<%= uid %>')" style="color: var(--accent-red); font-size: 0.75rem;">
                        <i class="fa-solid fa-lock"></i> Chiudi Sessione
                      </button>
                    </td>
                  </tr>
                <% }); } else { %>
                  <tr>
                    <td colspan="4" class="empty-state">Nessuna sessione Modmail aperta al momento.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: FORMS & APPLICATIONS ================= -->
      <div id="tab-forms" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-file-signature"></i>
            </div>
            <div>
              <h2 class="sub-title">Moduli Interattivi & Candidature Staff</h2>
              <p class="sub-desc">Crea questionari Discord personalizzati con finestre modali per candidature, sondaggi o autorizzazioni.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-file-lines"></i> Template Moduli Disponibili</div>
          </div>
          <div class="grid-2" style="margin-top: 1rem;">
            <div style="background: var(--bg-input); padding: 1.25rem; border-radius: 9px; border: 1px solid var(--border);">
              <div style="font-weight: 800; font-size: 1rem; color: var(--text-main);">Candidatura Staff RoomUp</div>
              <div style="font-size: 0.82rem; color: var(--text-muted); margin: 0.35rem 0 1rem 0;">Richiesta età, esperienza e motivazioni. Comando: <code>/apply staff_app</code></div>
              <span class="badge-tag green">ATTIVO</span>
            </div>
            <div style="background: var(--bg-input); padding: 1.25rem; border-radius: 9px; border: 1px solid var(--border);">
              <div style="font-weight: 800; font-size: 1rem; color: var(--text-main);">Richiesta Sban / Ricorso</div>
              <div style="font-size: 0.82rem; color: var(--text-muted); margin: 0.35rem 0 1rem 0;">Modulo ufficiale per la revisione delle sanzioni. Comando: <code>/apply unban_appeal</code></div>
              <span class="badge-tag yellow">ATTIVO</span>
            </div>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-inbox"></i> Risposte e Candidature Ricevute</div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID Invio</th>
                  <th>Modulo</th>
                  <th>Utente</th>
                  <th>Data</th>
                  <th>Stato</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  const guildSubs = (typeof forms !== 'undefined' && Array.isArray(forms?.submissions)) ? forms.submissions.filter(s => s.guildId === guildId) : [];
                  if (guildSubs.length > 0) { 
                    guildSubs.forEach(sub => { 
                %>
                  <tr>
                    <td><code><%= sub.id %></code></td>
                    <td><strong><%= sub.formTitle || sub.formId %></strong></td>
                    <td><%= sub.userTag %> <span style="font-size: 0.72rem; color: var(--text-dim);">(<%= sub.userId %>)</span></td>
                    <td><%= new Date(sub.createdAt).toLocaleString("it-IT") %></td>
                    <td>
                      <span class="badge-tag <%= sub.status === 'APPROVED' ? 'green' : (sub.status === 'REJECTED' ? 'red' : 'yellow') %>">
                        <%= sub.status || 'PENDING' %>
                      </span>
                    </td>
                    <td>
                      <% if (sub.status === 'PENDING') { %>
                        <button type="button" class="btn-probot-secondary btn-sm" onclick="updateFormSubDirect('<%= sub.id %>', 'APPROVED')" style="color: #2ecc71; font-size: 0.72rem; padding: 0.2rem 0.5rem;"><i class="fa-solid fa-check"></i></button>
                        <button type="button" class="btn-probot-secondary btn-sm" onclick="updateFormSubDirect('<%= sub.id %>', 'REJECTED')" style="color: #ef4444; font-size: 0.72rem; padding: 0.2rem 0.5rem;"><i class="fa-solid fa-xmark"></i></button>
                      <% } else { %>
                        <span style="font-size: 0.72rem; color: var(--text-dim);"><%= sub.reviewedBy || 'Revisionato' %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }); } else { %>
                  <tr>
                    <td colspan="6" class="empty-state">Nessuna candidatura o modulo inviato per questo server.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: KNOWLEDGE BASE & FAQ ================= -->
      <div id="tab-knowledge-base" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-book-bookmark"></i>
            </div>
            <div>
              <h2 class="sub-title">Knowledge Base & Risposte FAQ Automatiche</h2>
              <p class="sub-desc">Archivio guide e domande frequenti: il bot risponde automaticamente in chat quando gli utenti chiedono informazioni comuni.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-plus-circle"></i> Aggiungi Nuovo Articolo FAQ</div>
          </div>
          <div class="grid-3" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Categoria:</label>
              <input type="text" id="kb_category" class="form-control" placeholder="Generale, Regole, Minecraft...">
            </div>
            <div class="form-group">
              <label class="form-label">Titolo Articolo:</label>
              <input type="text" id="kb_title" class="form-control" placeholder="Es. Come entrare nel server...">
            </div>
            <div class="form-group">
              <label class="form-label">Parole Chiave (separate da virgola):</label>
              <input type="text" id="kb_keywords" class="form-control" placeholder="ip, connessione, bedrock, porta">
            </div>
          </div>
          <div class="form-group" style="margin-top: 1rem;">
            <label class="form-label">Risposta / Contenuto dell'Articolo:</label>
            <textarea id="kb_content" class="form-control" rows="3" placeholder="Scrivi la risposta che il bot fornirà automaticamente..."></textarea>
          </div>
          <div style="margin-top: 1rem; text-align: right;">
            <button type="button" class="btn-action" onclick="submitKnowledgeArticle()"><i class="fa-solid fa-floppy-disk"></i> Salva Articolo FAQ</button>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-book"></i> Articoli Salvati nella Knowledge Base</div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Categoria</th>
                  <th>Titolo</th>
                  <th>Parole Chiave</th>
                  <th>Anteprima Risposta</th>
                </tr>
              </thead>
              <tbody id="kbTableBody">
                <% if (typeof knowledgeBaseArticles !== 'undefined' && Array.isArray(knowledgeBaseArticles)) { %>
                  <% knowledgeBaseArticles.forEach(a => { %>
                    <tr>
                      <td><span class="badge-tag blue"><%= a.category %></span></td>
                      <td><strong><%= a.title %></strong></td>
                      <td><code><%= Array.isArray(a.keywords) ? a.keywords.join(', ') : a.keywords %></code></td>
                      <td style="max-width: 350px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= a.content %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

