                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.partnerships?.partnerChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Canale Log Partnership:</label>
              <select id="partLogChannelId" class="form-control">
                <option value="">-- Seleziona canale --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.partnerships?.logChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Ruolo da Menzionare (Ping):</label>
              <select id="partPingRole" class="form-control">
                <option value="@everyone" <%= config.partnerships?.pingRole === '@everyone' ? 'selected' : '' %>>@everyone</option>
                <option value="@here" <%= config.partnerships?.pingRole === '@here' ? 'selected' : '' %>>@here</option>
                <option value="" <%= !config.partnerships?.pingRole ? 'selected' : '' %>>Nessun ping</option>
                <% (roles || []).forEach(r => { %>
                  <option value="<%= r.id %>" <%= config.partnerships?.pingRole === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Ruolo Staff Partnership:</label>
              <select id="partStaffRole" class="form-control">
                <option value="">-- Chiunque con Gestisci Server --</option>
                <% (roles || []).forEach(r => { %>
                  <option value="<%= r.id %>" <%= (config.partnerships?.staffRoleIds || []).includes(r.id) ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>
