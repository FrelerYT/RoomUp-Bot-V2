              <label class="switch">
                <input type="checkbox" id="levUseCard" <%= config.levels?.useCardBanner !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div class="grid-3">
