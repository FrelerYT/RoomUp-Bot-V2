  <div id="toast"><i class="fa-solid fa-circle-check" style="color: #5865F2;"></i><span>Impostazioni salvate!</span></div>

  <script>
    const GUILD_ID = "<%= guildId %>";
    let hasUnsavedChanges = false;

    // ProBot Server Dropdown Switcher
    function toggleServerDropdown(event) {
      if (event) event.stopPropagation();
      const dd = document.getElementById('probotServerDropdown');
      if (!dd) return;
      const isOpen = dd.style.display === 'flex';
      dd.style.display = isOpen ? 'none' : 'flex';
    }

    document.addEventListener('click', (e) => {
      const dd = document.getElementById('probotServerDropdown');
      if (dd && dd.style.display === 'flex' && !dd.contains(e.target) && !e.target.closest('.btn-server-select')) {
        dd.style.display = 'none';
      }
    });

    // Safe DOM Getters (Crash-Proof Contract)
    const getVal = (id, def = "") => (document.getElementById(id)?.value ?? def).trim();
    const getChecked = id => Boolean(document.getElementById(id)?.checked);
    const getInt = (id, def = 0) => parseInt(document.getElementById(id)?.value, 10) || def;

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Unsaved changes watchdog
    function markUnsavedChanges() {
      hasUnsavedChanges = true;
      document.getElementById('floatingSaveBar')?.classList.add('visible');
    }

    function resetUnsavedChanges() {
      if (confirm("Vuoi annullare tutte le modifiche non salvate?")) {
        hasUnsavedChanges = false;
        location.reload();
      }
    }

    // Tab Dictionary for Breadcrumbs
    const TAB_TITLES = {
      'tab-overview': 'Panoramica',
      'tab-revisions': 'Cronologia Versioni',
      'tab-setup-wizard': 'Setup Wizard & Blueprint',
      'tab-backups': 'Backup & Ripristino',
      'tab-roles-manager': 'AutoRoles & Sticky',
      'tab-reaction-roles': 'Ruoli a Reazione',
      'tab-server-stats': 'Statistiche Server',
      'tab-verification': 'Sistema Verifica',
      'tab-welcome': 'Benvenuto & Addio',
      'tab-custom-commands': 'Comandi Rapidi',
      'tab-starboard': 'Starboard',
      'tab-antiraid': 'Anti-Raid & Screening',
      'tab-antinuke': 'Anti-Nuke & Panic Mode',
      'tab-automod': 'AutoMod & Filtri',
      'tab-warns': 'Avvertimenti & Warn',
      'tab-cases': 'Registro Casi & Prove',
      'tab-appeals': 'Segnalazioni & Ricorsi',
      'tab-aimod': 'Sentinel AI Moderator',
      'tab-logs': 'Audit Logs',
      'tab-tickets': 'Ticket Multi-Pannello',
      'tab-modmail': 'Hub Modmail Privato',
      'tab-forms': 'Moduli & Candidature',
      'tab-knowledge-base': 'Knowledge Base & FAQ',
      'tab-economy': 'Economia & Negozio',
      'tab-reputation': 'Reputazione Utenti',
      'tab-quests': 'Missioni & Obiettivi',
      'tab-social': 'Social & Confessioni',
      'tab-levels': 'Livelli & Punti XP',
      'tab-entertainment': 'Minigiochi Suite',
      'tab-counting': 'Gioco del Conteggio',
      'tab-voice': 'Vocali Temporanei',
      'tab-music': 'Modulo Musica & Voice',
      'tab-giveaways': 'Giveaway Community',
      'tab-suggestions': 'Suggerimenti',
      'tab-partnerships': 'Partnership',
      'tab-automations': 'Workflow Builder',
      'tab-integrations': 'Minecraft & GitHub',
      'tab-aiagent': 'Assistente AI',
      'tab-utilities': 'Sondaggi & Utility',
      'tab-sentinel': 'Sentinel Autonomous Staff System'
    };

    // Tab Switching Logic with Dynamic Breadcrumb
    function switchTab(tabId) {
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.classList.remove('ai-active');
      });

      const targetPane = document.getElementById(tabId);
      const targetBtn = document.querySelector(`.nav-btn[data-tab="${tabId}"]`);

      if (targetPane) {
        targetPane.classList.add('active');
        document.querySelector('.main-workspace')?.scrollTo({ top: 0, behavior: 'smooth' });
      }
      if (targetBtn) {
        if (tabId === 'tab-aimod') {
          targetBtn.classList.add('ai-active');
        } else {
          targetBtn.classList.add('active');
        }
      }

      // Dynamic breadcrumb sync
      const breadcrumb = document.getElementById('currentTabBreadcrumb');
      if (breadcrumb && TAB_TITLES[tabId]) {
        breadcrumb.textContent = TAB_TITLES[tabId];
      }

      // Auto-close sidebar on mobile/tablet upon tab selection
      if (window.innerWidth <= 1024) {
        closeMobileSidebar();
      }

      window.location.hash = tabId.replace('tab-', '');
      if (tabId === 'tab-sentinel' && typeof loadSentinelAllData === 'function') {
        loadSentinelAllData();
      }
    }

    // Client-side Overview Modules Filter
    function filterOverviewModules() {
      const query = (document.getElementById('overviewModuleSearch')?.value || '').toLowerCase().trim();
      const sections = document.querySelectorAll('.module-section');
      
      sections.forEach(section => {
        let visibleCount = 0;
        const cards = section.querySelectorAll('.module-card');
        cards.forEach(card => {
          const name = (card.getAttribute('data-module-name') || '').toLowerCase();
          const cat = (card.getAttribute('data-category') || '').toLowerCase();
          const desc = (card.querySelector('.module-card-desc')?.textContent || '').toLowerCase();
          
          if (!query || name.includes(query) || cat.includes(query) || desc.includes(query)) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });
        
        section.style.display = visibleCount > 0 ? '' : 'none';
      });
    }

    function syncOverviewSwitch(targetId, isChecked) {
      const el = document.getElementById(targetId);
      if (el) {
        el.checked = isChecked;
        markUnsavedChanges();
        showToast(`Modulo ${isChecked ? 'attivato' : 'disattivato'}`);
      }
    }

    function copyGuildId(id) {
      if (!id) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(id).then(() => {
          showToast("ID copiato negli appunti");
        }).catch(() => {
          prompt("ID Server:", id);
        });
      } else {
        prompt("ID Server:", id);
      }
    }

    function initOverviewSwitches() {
      const syncPairs = [
        ['ov_aiEnabled', 'aiEnabled'],
        ['ov_autoModEnabled', 'autoModEnabled'],
        ['ov_raidEnabled', 'raidEnabled'],
        ['ov_antiNukeEnabled', 'antiNukeEnabled'],
        ['ov_warnsEnabled', 'warnsEnabled'],
        ['ov_tickEnabled', 'tickEnabled'],
        ['ov_verEnabled', 'verEnabled'],
        ['ov_welEnabled', 'welEnabled'],
        ['ov_levEnabled', 'levEnabled'],
        ['ov_voiceEnabled', 'voiceEnabled'],
        ['ov_entEnabled', 'entEnabled'],
        ['ov_utilEnabled', 'utilEnabled'],
        ['ov_intEnabled', 'intEnabled'],
        ['ov_agentEnabled', 'agentEnabled'],
        ['ov_givEnabled', 'givEnabled'],
        ['ov_sugEnabled', 'sugEnabled'],
        ['ov_partEnabled', 'partEnabled'],
        ['ov_starEnabled', 'starEnabled'],
        ['ov_statsEnabled', 'statsEnabled'],
        ['ov_countEnabled', 'countEnabled'],
        ['ov_logsMasterToggle', 'logsMasterToggle']
      ];
      syncPairs.forEach(([ovId, realId]) => {
        const ov = document.getElementById(ovId);
        const real = document.getElementById(realId);
        if (ov && real) {
          ov.checked = real.checked;
          real.addEventListener('change', () => {
            ov.checked = real.checked;
            markUnsavedChanges();
          });
        }
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      initOverviewSwitches();
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(`tab-${hash}`)) {
        switchTab(`tab-${hash}`);
      }

      // Attach change listener to all form controls for the floating save bar
      document.querySelectorAll('input, select, textarea').forEach(control => {
        control.addEventListener('change', markUnsavedChanges);
        if (control.tagName === 'INPUT' && control.type === 'text') {
          control.addEventListener('input', markUnsavedChanges);
        }
      });
    });

    window.addEventListener('beforeunload', (e) => {
      if (hasUnsavedChanges) {
        e.preventDefault();
        e.returnValue = '';
      }
    });

    function toggleMobileSidebar() {
      const sidebar = document.getElementById('mainSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (!sidebar) return;
      const isOpen = sidebar.classList.toggle('open');
      if (backdrop) {
        if (isOpen) {
          backdrop.style.display = 'block';
          requestAnimationFrame(() => backdrop.classList.add('active'));
        } else {
          backdrop.classList.remove('active');
          setTimeout(() => { if (!backdrop.classList.contains('active')) backdrop.style.display = 'none'; }, 250);
        }
      }
    }

    function closeMobileSidebar() {
      const sidebar = document.getElementById('mainSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (sidebar) sidebar.classList.remove('open');
      if (backdrop) {
        backdrop.classList.remove('active');
        setTimeout(() => { if (!backdrop.classList.contains('active')) backdrop.style.display = 'none'; }, 250);
      }
    }

    // Touch gesture: swipe left on mobile sidebar drawer to close
    (function initMobileGestures() {
      let touchStartX = 0;
      let touchStartY = 0;
      const sidebarEl = document.getElementById('mainSidebar');
      if (!sidebarEl) return;

      sidebarEl.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      sidebarEl.addEventListener('touchend', e => {
        const touchEndX = e.changedTouches[0].screenX;
        const touchEndY = e.changedTouches[0].screenY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;
        // If swiped left by at least 45px with primarily horizontal motion
        if (diffX < -45 && Math.abs(diffX) > Math.abs(diffY)) {
          closeMobileSidebar();
        }
      }, { passive: true });
    })();

    function showToast(msg, isError = false) {
      const t = document.getElementById('toast');
      if (!t) return;
      const cleanMsg = msg.replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{1F000}-\u{1F02F}\u{1F0A0}-\u{1F0FF}\u{1F100}-\u{1F64F}\u{1F680}-\u{1F6FF}]/gu, '').trim();
      const icon = isError 
        ? '<i class="fa-solid fa-circle-exclamation" style="color: var(--accent-red); font-size: 1.1rem;"></i>' 
        : '<i class="fa-solid fa-circle-check" style="color: #5865F2; font-size: 1.1rem;"></i>';
      t.innerHTML = icon + '<span>' + cleanMsg + '</span>';
      t.className = isError ? "show error" : "show";
      setTimeout(() => { 
        if (t.className.includes("show")) {
          t.className = t.className.replace("show", "").replace("error", "").trim(); 
        }
      }, 3400);
    }

