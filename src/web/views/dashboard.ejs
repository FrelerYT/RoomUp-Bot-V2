    let sentinelKbCache = [];

    async function loadSentinelAllData() {
      await Promise.allSettled([
        loadSentinelHealthMetrics(),
        loadSentinelConfig(),
        loadSentinelKnowledge(),
        loadSentinelLearningQueue()
      ]);
    }

    async function loadSentinelHealthMetrics() {
      try {
        const [healthRes, metricsRes] = await Promise.all([
          fetch(`/api/dashboard/${GUILD_ID}/sentinel/health`),
          fetch(`/api/dashboard/${GUILD_ID}/sentinel/metrics`)
        ]);
        const healthData = await healthRes.json();
        const metricsData = await metricsRes.json();

        if (healthData.success) {
          const statusEl = document.getElementById('sentinelHealthStatus');
          if (statusEl) {
            const overall = healthData.health?.overallStatus || healthData.health?.aiStatus || 'HEALTHY';
            statusEl.textContent = overall;
            statusEl.style.color = (overall === 'CRITICAL' || overall === 'DEGRADED') ? '#ef4444' : '#2ecc71';
          }
          const modelEl = document.getElementById('sentinelModelActive');
          if (modelEl) {
            const keys = healthData.modelStats?.activeKeysCount ?? healthData.modelStats?.activeKeys ?? 5;
            const total = healthData.modelStats?.totalKeys || 5;
            modelEl.textContent = `${keys}/${total} Attive`;
          }
        }

        if (metricsData.success && metricsData.metrics) {
          const avgEl = document.getElementById('sentinelAvgTime');
          if (avgEl) {
            avgEl.textContent = `${Math.round(metricsData.metrics.averageResponseTimeMs || 0)} ms`;
          }
          const resEl = document.getElementById('sentinelResRate');
          if (resEl) {
            resEl.textContent = `${Math.round((metricsData.metrics.resolutionRate || 1) * 100)}%`;
          }
        }
      } catch (err) {
        console.error('Errore recupero metriche Sentinel:', err);
      }
    }

    async function loadSentinelConfig() {
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/config`);
        const data = await res.json();
        if (data.success && data.ai) {
          const autoSelect = document.getElementById('sentinelAutonomyLevel');
          if (autoSelect && data.ai.autonomyLevel !== undefined) {
            autoSelect.value = String(data.ai.autonomyLevel);
          }
          const tempSelect = document.getElementById('sentinelTemperature');
          if (tempSelect && data.ai.temperature !== undefined) {
            tempSelect.value = String(data.ai.temperature);
          }
          const riskSelect = document.getElementById('sentinelMaxRisk');
          if (riskSelect && data.ai.maxRisk) {
            riskSelect.value = data.ai.maxRisk;
          }
        }
      } catch (err) {
        console.error('Errore caricamento config Sentinel:', err);
      }
    }

