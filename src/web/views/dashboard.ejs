          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Frase o Pattern</th>
                  <th>Origine</th>
                  <th>Azione</th>
                  <th>Severità</th>
                  <th>Data</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody id="precedentsTableBody">
                <% const precList = (aiMemory?.precedents || []); %>
                <% if (precList.length === 0) { %>
                  <tr>
                    <td colspan="6" class="empty-state">L'AI sta ascoltando il server. Appena un moderatore applica un timeout, cancella un messaggio o risponde a una consultazione, la regola apparirà qui!</td>
                  </tr>
                <% } else { %>
                  <% precList.slice().reverse().forEach(p => { %>
                    <tr id="row_<%= p.id %>">
                      <td>
                        <strong>"<%= p.pattern || p.rawContent || 'Pattern' %>"</strong>
                        <% if (p.rawContent && p.rawContent !== p.pattern) { %>
                          <div style="font-size: 0.72rem; color: var(--text-muted);">Origine: <%= p.rawContent %></div>
                        <% } %>
                      </td>
                      <td>
                        <% if (p.source === 'human_audit_observation') { %>
                          <span class="badge-tag blue">AUDIT STAFF</span>
                        <% } else if (p.source === 'human_mod_feedback') { %>
                          <span class="badge-tag green">CONSULTO</span>
                        <% } else { %>
                          <span class="badge-tag">MANUALE</span>
                        <% } %>
                      </td>
                      <td><code><%= (p.actionTaken || 'warn').toUpperCase() %></code></td>
                      <td>
                        <span style="color: <%= p.severity === 'high' ? 'var(--accent-red)' : 'var(--accent-yellow)' %>; font-weight: 800;">
                          <%= (p.severity || 'medium').toUpperCase() %>
                        </span>
                      </td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(p.timestamp).toLocaleDateString('it-IT') %></td>
                      <td>
                        <button type="button" class="btn-danger" onclick="deleteAiPrecedent('<%= p.id %>')"><i class="fa-solid fa-trash"></i></button>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Live Sentinel AI Simulator Playground -->
        <div class="dashboard-card" >
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-vial-circle-check"></i> Prova l'AI in Tempo Reale</div>
              <div class="card-desc">Scrivi una frase di test per verificare la reazione dell'AI.</div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Messaggio di Prova:</label>
            <div style="display: flex; gap: 0.75rem;">
              <input type="text" id="aiSimulateInput" class="form-control" placeholder="Es. scrivi una frase qui..." style="flex: 1;">
              <button type="button" class="btn-action" onclick="testAiSimulation()" class="btn-action btn-save" style="font-weight: 800; white-space: nowrap;">
                <i class="fa-solid fa-play"></i> Analizza
              </button>
            </div>
            <div style="margin-top: 0.65rem; font-size: 0.78rem; color: var(--text-muted);">
              Esempi rapidi:
              <span class="var-chip" onclick="document.getElementById('aiSimulateInput').value='coglione muori'; testAiSimulation();">Insulto Grave</span>
              <span class="var-chip" onclick="document.getElementById('aiSimulateInput').value='fai schifo stai zitto'; testAiSimulation();">Provocazione Dubbia</span>
              <span class="var-chip" onclick="document.getElementById('aiSimulateInput').value='Ciao ragazzi, benvenuti nel nostro server!'; testAiSimulation();">Messaggio Normale</span>
            </div>
          </div>

          <div id="aiSimulateResultBox" style="display: none; margin-top: 1.25rem; padding: 1.25rem; border-radius: 10px; background: rgba(0,0,0,0.35); border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem;">
              <div style="font-size: 0.9rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem;" id="aiSimVerdictTitle">
                <!-- Injected via JS -->
              </div>
              <div id="aiSimSuspicionBadge" style="font-weight: 900; font-size: 1.1rem;">
                <!-- Injected via JS -->
              </div>
            </div>
            <div style="height: 8px; width: 100%; background: rgba(255,255,255,0.08); border-radius: 4px; overflow: hidden; margin-bottom: 1rem;">
              <div id="aiSimBar" style="height: 100%; width: 0%; transition: width 0.4s ease; border-radius: 4px;"></div>
            </div>
            <div class="grid-2" style="font-size: 0.84rem;">
              <div>
                <strong style="color: var(--text-muted); display: block; margin-bottom: 0.25rem;">Anomalie Rilevate:</strong>
                <ul id="aiSimIssuesList" style="padding-left: 1.2rem; color: var(--text-main);"></ul>
              </div>
              <div>
                <strong style="color: var(--text-muted); display: block; margin-bottom: 0.25rem;">Decisione dell'AI:</strong>
                <p id="aiSimDecisionDetail" style="color: var(--text-main); line-height: 1.4;"></p>
              </div>
            </div>
          </div>
        </div>
      <!-- ================= TAB: SENTINEL AUTONOMOUS STAFF SYSTEM ================= -->
      <div id="tab-sentinel" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle" style="background: linear-gradient(135deg, #5865F2, #8b5cf6);">
              <i class="fa-solid fa-user-astronaut"></i>
            </div>
            <div>
              <h2 class="sub-title">Sentinel Autonomous Staff System</h2>
              <p class="sub-desc">Architettura autonoma di supporto, moderazione neurale, isolamento multi-tenant, knowledge versionata e simulazione live.</p>
            </div>
          </div>
          <div class="sub-header-right">
            <button type="button" class="btn btn-outline" onclick="loadSentinelAllData()"><i class="fa-solid fa-arrows-rotate"></i> Aggiorna Stato</button>
          </div>
        </div>

        <!-- 1. HEALTH & METRICS STRIP -->
        <div class="grid-4" style="margin-bottom: 1.25rem;">
          <div class="metric-box">
