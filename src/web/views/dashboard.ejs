              <div class="card-desc">Personalizza titolo, colori, footer e il testo di congratulazioni.</div>
            </div>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Titolo Embed:</label>
              <input type="text" id="levEmbedTitle" class="form-control" value="<%= config.levels?.embedTitle || 'Level Up!' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Barra Embed:</label>
              <div class="color-picker-group">
                <input type="color" id="levColor" value="<%= config.levels?.embedColor || '#f1c40f' %>" class="color-picker-input" onchange="document.getElementById('levColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="levColorHex" class="form-control" value="<%= config.levels?.embedColor || '#f1c40f' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('levColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Testo Footer Embed:</label>
              <input type="text" id="levFooterText" class="form-control" value="<%= config.levels?.embedFooterText || 'Continua a chattare per salire di rango!' %>" oninput="markUnsavedChanges()">
