                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.integrations?.githubLogChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
