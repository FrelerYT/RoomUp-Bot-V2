            <div class="form-group">
              <label class="form-label">Testo Footer Embed:</label>
              <input type="text" id="countFooterText" class="form-control" value="<%= config.counting?.embedFooter || 'RoomUp! Games • Record: {highestScore}' %>" oninput="markUnsavedChanges()">
