              <label class="switch">
                <input type="checkbox" id="levRoleRewards" <%= config.levels?.roleRewardsEnabled ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
