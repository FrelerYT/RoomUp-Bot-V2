        <div class="dashboard-card" >
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-robot"></i> Impostazioni Generali</div>
              <div class="card-desc">Scegli come deve intervenire l'AI e quando chiedere aiuto allo staff.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="aiEnabled" <%= config.aiModerator?.enabled ? 'checked' : '' %>>
              <span class="slider" style="background-color: #2e3440;"></span>
            </label>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Canale per i dubbi dell'AI:</label>
              <select id="aiConsultChannel" class="form-control">
                <option value="">-- Seleziona canale (es. #mod-chat) --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.aiModerator?.consultationChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Modalità di Intervento:</label>
              <select id="aiMode" class="form-control">
                <option value="autonomous" <%= config.aiModerator?.mode !== 'consult_only' ? 'selected' : '' %>>Autonoma (Interviene subito e consulta lo staff sui casi dubbi)</option>
                <option value="consult_only" <%= config.aiModerator?.mode === 'consult_only' ? 'selected' : '' %>>Solo Consulto (Chiede sempre parere allo staff)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Sensibilità:</label>
              <select id="aiSensitivity" class="form-control">
                <option value="low" <%= config.aiModerator?.sensitivity === 'low' ? 'selected' : '' %>>Bassa</option>
                <option value="medium" <%= (config.aiModerator?.sensitivity === 'medium' || !config.aiModerator?.sensitivity) ? 'selected' : '' %>>Bilanciata (Consigliata)</option>
                <option value="high" <%= config.aiModerator?.sensitivity === 'high' ? 'selected' : '' %>>Alta</option>
                <option value="strict" <%= config.aiModerator?.sensitivity === 'strict' ? 'selected' : '' %>>Massima</option>
              </select>
            </div>
          </div>

          <div class="grid-3" style="margin-top: 1.25rem;">
            <div class="metric-box">
              <div class="metric-icon" style="background: rgba(88, 101, 242, 0.12); color: #5865F2;"><i class="fa-solid fa-shield-halved"></i></div>
              <div class="metric-info">
                <div class="metric-val"><%= aiMemory?.stats?.autonomousActions || 0 %></div>
                <div class="metric-label">Azioni Autonome</div>
              </div>
            </div>
            <div class="metric-box">
              <div class="metric-icon" style="background: rgba(240,178,50,0.15); color: var(--accent-yellow);"><i class="fa-solid fa-comments"></i></div>
              <div class="metric-info">
                <div class="metric-val"><%= aiMemory?.stats?.humanEscalations || 0 %></div>
                <div class="metric-label">Richieste allo Staff</div>
              </div>
            </div>
            <div class="metric-box">
