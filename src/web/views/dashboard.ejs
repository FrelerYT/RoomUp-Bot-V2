              <div class="metric-val" id="sentinelResRate">100%</div>
              <div class="metric-lbl">Tasso Risoluzione Ticket</div>
            </div>
          </div>
        </div>

        <!-- 2. AUTONOMY & POLICY CONFIGURATION -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-sliders"></i> Livello di Autonomia & Policy</div>
              <div class="card-desc">Determina il grado di indipendenza decisionale ed esecutiva di Sentinel AI per questo server.</div>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <span id="canaryStatusBadge" class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 0.35rem 0.75rem; border-radius: 6px; font-weight: 700; font-size: 0.75rem;">
                <i class="fa-solid fa-shield-virus"></i> Canary Mode
              </span>
              <label class="switch">
                <input type="checkbox" id="sentinelCanaryToggle" onchange="toggleSentinelCanaryMode(this.checked)">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Livello Autonomia (0 - 5):</label>
              <select id="sentinelAutonomyLevel" class="form-control" onchange="saveSentinelCoreConfig()">
                <option value="0">Livello 0 — AI Spenta (Disabilitata)</option>
                <option value="1">Livello 1 — Solo Chat & Risposte Passive</option>
                <option value="2">Livello 2 — Assistente Ticket (Lettura & Suggerimenti)</option>
                <option value="3">Livello 3 — Supporto Autonomo (Messaggi & Metadati Ticket)</option>
                <option value="4" selected>Livello 4 — Supporto + Azioni a Basso Rischio (Consigliato)</option>
                <option value="5">Livello 5 — Full Autonomous Staff (Tutti gli strumenti abilitati)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Temperatura Decisionale:</label>
              <select id="sentinelTemperature" class="form-control" onchange="saveSentinelCoreConfig()">
                <option value="0.1">0.1 — Massima Precisione Deterministica</option>
                <option value="0.2" selected>0.2 — Bilanciato Razionale (Default)</option>
                <option value="0.4">0.4 — Più Fluido & Conversazionale</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Rischio Massimo Autonomo:</label>
              <select id="sentinelMaxRisk" class="form-control" onchange="saveSentinelCoreConfig()">
                <option value="LOW" selected>LOW — Solo azioni sicure (messaggi, tag, log)</option>
                <option value="MEDIUM">MEDIUM — Include timeout brevi e chiusura ticket</option>
                <option value="HIGH">HIGH — Include timeout estesi e ruoli</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 3. KNOWLEDGE BASE ENGINE WITH VERSIONING -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-book-bookmark"></i> Knowledge Engine & Documenti con Versioning</div>
              <div class="card-desc">Conoscenze ufficiali del server suddivise per categorie, con storico delle revisioni e rollback immediato.</div>
            </div>
            <button type="button" class="btn btn-primary btn-sm" onclick="openAddKnowledgeModal()"><i class="fa-solid fa-plus"></i> Aggiungi Documento</button>
          </div>

          <div style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <input type="text" id="sentinelKbSearch" class="form-control" placeholder="Cerca documento per titolo, contenuto o parola chiave..." onkeyup="filterSentinelKnowledge()">
            <select id="sentinelKbCatFilter" class="form-control" style="max-width: 220px;" onchange="filterSentinelKnowledge()">
              <option value="">Tutte le categorie</option>
              <option value="SERVER_RULES">Regolamento</option>
              <option value="SERVER_FAQ">FAQ</option>
              <option value="SERVER_PROCEDURES">Procedure Staff</option>
              <option value="LEARNED_KNOWLEDGE">Apprese Autonomamente</option>
            </select>
          </div>

          <div class="table-responsive">
            <table class="table" id="sentinelKbTable">
              <thead>
                <tr>
                  <th>Titolo</th>
                  <th>Categoria</th>
                  <th>Fonte</th>
                  <th>Versione</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody id="sentinelKbList">
                <tr><td colspan="5" style="text-align: center; color: var(--text-dim);">Caricamento knowledge base in corso...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. LIVE LEARNING QUEUE -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-graduation-cap"></i> Coda di Apprendimento Live (Staff Feedback Loop)</div>
              <div class="card-desc">Procedure e risposte apprese osservando lo staff nel ticket, in attesa di approvazione o rifiuto.</div>
            </div>
            <button type="button" class="btn btn-outline btn-sm" onclick="loadSentinelLearningQueue()"><i class="fa-solid fa-arrows-rotate"></i> Aggiorna Coda</button>
          </div>

          <div id="sentinelLearningQueueList" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="text-align: center; color: var(--text-dim); padding: 1.5rem;">Caricamento coda di apprendimento...</div>
          </div>
        </div>

        <!-- 5. MEMORY & SIMULATOR -->
        <div class="grid-2">
          <div class="dashboard-card">
            <div class="card-header">
              <div>
                <div class="card-title"><i class="fa-solid fa-database"></i> Isolamento Memoria Multi-Tenant</div>
                <div class="card-desc">Esporta o azzera la memoria procedurale isolata di questo server.</div>
              </div>
            </div>
            <div style="display: flex; gap: 0.75rem;">
              <button type="button" class="btn btn-outline" onclick="exportSentinelMemory()"><i class="fa-solid fa-download"></i> Esporta Memoria JSON</button>
              <button type="button" class="btn btn-danger" onclick="clearSentinelMemory()"><i class="fa-solid fa-trash-can"></i> Resetta Memoria Server</button>
            </div>
          </div>

          <div class="dashboard-card">
            <div class="card-header">
              <div>
                <div class="card-title"><i class="fa-solid fa-vial-circle-check"></i> Simulatore Live Sentinel</div>
                <div class="card-desc">Testa la reazione neurale di Sentinel senza toccare Discord reale.</div>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <div style="display: flex; gap: 0.5rem;">
                <select id="sentinelSimType" class="form-control" style="max-width: 160px;">
                  <option value="message">Messaggio</option>
                  <option value="moderation">Moderazione</option>
                  <option value="staff_takeover">Staff Takeover</option>
                </select>
                <input type="text" id="sentinelSimInput" class="form-control" placeholder="Testo da simulare...">
                <button type="button" class="btn btn-primary" onclick="runSentinelSim()"><i class="fa-solid fa-play"></i> Simula</button>
