            <div style="margin-top: 0.4rem;">
              <span class="var-chip" onclick="insertVar('partDescTemplate', '{partnerGuild}')">{partnerGuild}</span>
              <span class="var-chip" onclick="insertVar('partDescTemplate', '{invite}')">{invite}</span>
              <span class="var-chip" onclick="insertVar('partDescTemplate', '{adText}')">{adText}</span>
              <span class="var-chip" onclick="insertVar('partDescTemplate', '{user}')">{user}</span>
            </div>
          </div>
        </div>

        <!-- ================= RETE SERVER PARTNER & COLLABORAZIONI ================= -->
        <% const safeCollabs = (typeof collabs !== 'undefined' && collabs) ? collabs : { connected: [], incoming: [], outgoing: [] }; %>
        <% const safeAllBotGuilds = (typeof allBotGuilds !== 'undefined' && allBotGuilds) ? allBotGuilds : []; %>
        <div class="dashboard-card" style="border: 1px solid rgba(88, 101, 242, 0.35); box-shadow: 0 4px 20px rgba(88, 101, 242, 0.08);">
          <div class="card-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
            <div>
              <div class="card-title" style="display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-network-wired" style="color: var(--primary);"></i> Rete Server Partner & Sincronizzazione Collaborazioni
              </div>
              <div class="card-desc">
                Collega altri server Discord per sincronizzare automaticamente le partnership approvate. La collaborazione richiede l'accettazione esplicita dell'Owner o di un Amministratore dell'altro server e può essere revocata in qualsiasi momento.
              </div>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <span class="badge-tag blue" title="Server attualmente connessi"><i class="fa-solid fa-link"></i> <%= (safeCollabs.connected || []).length %> Connessi</span>
              <% if ((safeCollabs.incoming || []).length > 0) { %>
                <span class="badge-tag amber" style="background: rgba(241, 196, 15, 0.2); color: #f1c40f; border: 1px solid #f1c40f;">
                  <i class="fa-solid fa-bell"></i> <%= safeCollabs.incoming.length %> Nuove Richieste
                </span>
              <% } %>
            </div>
          </div>

          <!-- Richieste Ricevute (In Sospeso) -->
          <% if ((safeCollabs.incoming || []).length > 0) { %>
            <div style="background: rgba(241, 196, 15, 0.08); border: 1px solid rgba(241, 196, 15, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
              <h4 style="color: #f1c40f; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-bell"></i> Richieste di Collaborazione Ricevute (In attesa della tua approvazione)
              </h4>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
                I seguenti server hanno richiesto di collegarsi al tuo per sincronizzare le partnership. Accetta solo server fidati!
              </p>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Server Richiedente</th>
                      <th>Membri</th>
                      <th>Data Richiesta</th>
                      <th>Azioni</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% safeCollabs.incoming.forEach(inc => { %>
                      <tr>
                        <td>
                          <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <% if (inc.requesterGuildIcon) { %>
                              <img src="<%= inc.requesterGuildIcon %>" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">
                            <% } else { %>
                              <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--bg-hover); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700;">#</div>
                            <% } %>
                            <div>
                              <strong><%= inc.requesterGuildName %></strong>
                              <div style="font-size: 0.7rem; color: var(--text-muted);">ID: <%= inc.requesterGuildId %></div>
                            </div>
                          </div>
                        </td>
                        <td><%= inc.requesterMemberCount || '-' %></td>
                        <td><%= new Date(inc.createdAt).toLocaleString("it-IT") %></td>
                        <td>
                          <div style="display: flex; gap: 0.4rem;">
                            <button type="button" class="btn-action" style="background: #23a55a; color: white; padding: 0.35rem 0.75rem;" onclick="acceptCollab('<%= inc.id %>')">
                              <i class="fa-solid fa-check"></i> Accetta
                            </button>
                            <button type="button" class="btn-danger" style="padding: 0.35rem 0.75rem;" onclick="rejectCollab('<%= inc.id %>')">
                              <i class="fa-solid fa-xmark"></i> Rifiuta
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>

          <!-- Server Partner Attualmente Connessi -->
          <div style="margin-bottom: 1.5rem;">
            <h4 style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem;">
              <i class="fa-solid fa-handshake" style="color: #23a55a;"></i> Server Partner Collegati Attivi
            </h4>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Server Partner</th>
                    <th>ID Server</th>
                    <th>Data Collegamento</th>
                    <th>Stato Sincronizzazione</th>
                    <th>Azioni</th>
                  </tr>
                </thead>
                <tbody>
                  <% const connectedList = safeCollabs.connected || []; %>
                  <% if (connectedList.length === 0) { %>
                    <tr>
                      <td colspan="5" class="empty-state" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">
                        Nessun altro server collegato. Usa il modulo qui sotto per invitare un altro server Discord alla rete.
                      </td>
                    </tr>
                  <% } else { %>
                    <% connectedList.forEach(c => { %>
                      <% const isRequester = c.requesterGuildId === guildId; %>
                      <% const otherName = isRequester ? c.targetGuildName : c.requesterGuildName; %>
                      <% const otherIcon = isRequester ? c.targetGuildIcon : c.requesterGuildIcon; %>
                      <% const otherId = isRequester ? c.targetGuildId : c.requesterGuildId; %>
                      <tr>
                        <td>
                          <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <% if (otherIcon) { %>
                              <img src="<%= otherIcon %>" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">
                            <% } else { %>
                              <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--bg-hover); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700;">#</div>
                            <% } %>
                            <strong><%= otherName %></strong>
                          </div>
                        </td>
                        <td><code><%= otherId %></code></td>
                        <td><%= c.respondedAt ? new Date(c.respondedAt).toLocaleDateString("it-IT") : new Date(c.createdAt).toLocaleDateString("it-IT") %></td>
                        <td>
                          <span class="badge-tag green"><i class="fa-solid fa-rotate"></i> ATTIVA & SINCRONIZZATA</span>
                        </td>
                        <td>
                          <button type="button" class="btn-danger" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" onclick="removeCollab('<%= c.id %>')">
                            <i class="fa-solid fa-link-slash"></i> Disconnetti
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Modulo Invia Richiesta Collegamento -->
          <div style="background: var(--bg-surface-2, rgba(255,255,255,0.03)); border: 1px dashed var(--border-color); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
            <h4 style="margin-bottom: 0.4rem; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem;">
              <i class="fa-solid fa-plus-circle" style="color: var(--primary);"></i> Invia Richiesta di Collaborazione a un Server
            </h4>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem;">
              Seleziona un altro server in cui è presente il bot oppure inserisci manualmente l'ID del server Discord. L'Owner dell'altro server riceverà una notifica e potrà accettare.
            </div>

            <div style="display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; align-items: end;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Seleziona Server o Inserisci ID:</label>
                <div style="display: flex; gap: 0.5rem;">
                  <select id="collabTargetSelect" class="form-control" onchange="document.getElementById('collabTargetCustom').value = this.value;">
                    <option value="">-- Seleziona tra i server del bot --</option>
                    <% safeAllBotGuilds.forEach(bg => { %>
                      <option value="<%= bg.id %>"><%= bg.name %> (<%= bg.memberCount || 0 %> membri - ID: <%= bg.id %>)</option>
                    <% }) %>
                  </select>
                  <input type="text" id="collabTargetCustom" class="form-control" placeholder="Oppure incolla Server ID Discord..." style="max-width: 260px;">
                </div>
              </div>
              <button type="button" class="btn-action" style="white-space: nowrap; height: 38px; display: flex; align-items: center; gap: 0.4rem;" onclick="sendCollabRequest()">
                <i class="fa-solid fa-paper-plane"></i> Invia Richiesta
              </button>
            </div>
          </div>

          <!-- Richieste Inviate (In Attesa dell'Altro Server) -->
          <% const outgoingList = safeCollabs.outgoing || []; %>
          <% if (outgoingList.length > 0) { %>
            <div>
              <h4 style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--text-muted);">
                <i class="fa-solid fa-clock"></i> Richieste Inviate in Attesa di Risposta
              </h4>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Server Destinatario</th>
                      <th>ID Server</th>
                      <th>Data Invio</th>
                      <th>Stato</th>
                      <th>Azioni</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% outgoingList.forEach(outg => { %>
                      <tr>
                        <td>
                          <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <% if (outg.targetGuildIcon) { %>
                              <img src="<%= outg.targetGuildIcon %>" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;">
                            <% } else { %>
                              <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--bg-hover); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700;">#</div>
                            <% } %>
                            <strong><%= outg.targetGuildName %></strong>
                          </div>
                        </td>
                        <td><code><%= outg.targetGuildId %></code></td>
                        <td><%= new Date(outg.createdAt).toLocaleString("it-IT") %></td>
                        <td><span class="badge-tag amber"><i class="fa-solid fa-spinner fa-spin"></i> IN ATTESA</span></td>
                        <td>
                          <button type="button" class="btn-danger" style="padding: 0.3rem 0.6rem; font-size: 0.72rem;" onclick="cancelCollab('<%= outg.id %>')">
                            <i class="fa-solid fa-ban"></i> Annulla
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Live Partnerships Table -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-list"></i> Partnership Attive</div>
              <div class="card-desc">Tutte le partnership registrate su RoomUp!</div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Partner</th>
                  <th>Server Origine</th>
                  <th>Data</th>
                  <th>Stato</th>
                  <th>Azioni</th>
                </tr>
              </thead>
              <tbody>
                <% const pList = (partnersData?.partners || []); %>
                <% if (pList.length === 0) { %>
                  <tr>
                    <td colspan="6" class="empty-state">Nessuna partnership registrata. Usa il comando <code>/partner</code> per iniziare.</td>
                  </tr>
                <% } else { %>
                  <% pList.slice().reverse().forEach(p => { %>
                    <tr>
                      <td style="font-weight: 800; color: var(--primary);">#<%= p.number %></td>
                      <td>
                        <strong><%= p.collaboratorTag || p.collaboratorId %></strong>
                        <div style="font-size: 0.72rem; color: var(--text-muted);">ID: <%= p.collaboratorId %></div>
                      </td>
                      <td>ID: <%= p.originGuildId %></td>
                      <td><%= new Date(p.createdAt).toLocaleDateString("it-IT") %></td>
                      <td>
                        <% if (p.deleted) { %>
                          <span class="badge-tag red">REVOCATA</span>
                        <% } else { %>
                          <span class="badge-tag green">ATTIVA (<%= (p.messages || []).length %> Server)</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (!p.deleted) { %>
                          <button type="button" class="btn-danger" onclick="deletePartnership('<%= p.number %>')"><i class="fa-solid fa-trash"></i> Elimina</button>
                        <% } else { %>
                          <span style="color: var(--text-muted); font-size: 0.75rem;">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= TAB: TICKETS ================= -->
      <div id="tab-tickets" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-ticket"></i>
            </div>
            <div>
              <h2 class="sub-title">Ticket di Supporto</h2>
              <p class="sub-desc">Sistema completo di assistenza privata con categorie multiple, trascrizioni automatiche e ruoli staff.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-sliders"></i> Funzionalità & Azioni Ticket</div>
              <div class="card-desc">Attiva o disattiva le singole opzioni del sistema di assistenza.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="tickEnabled" <%= config.tickets?.enabled ? 'checked' : '' %> onchange="markUnsavedChanges()">
              <span class="slider"></span>
            </label>
          </div>

          <div class="grid-3" style="margin-bottom: 1.25rem;">
            <div class="setting-item-box">
              <div>
                <div class="setting-title">Pulsante Claim Staff</div>
                <div class="setting-desc">Consente ai mod di rivendicare il ticket</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tickAllowClaim" <%= config.tickets?.allowClaim ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Chiusura dall'Utente</div>
                <div class="setting-desc">Consente all'utente di chiudere il proprio ticket</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tickAllowClose" <%= config.tickets?.allowClose ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Genera Trascrizione</div>
                <div class="setting-desc">Salva la trascrizione HTML/TXT dei messaggi</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tickGenerateTranscript" <%= config.tickets?.generateTranscript ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Transcript nei DM</div>
                <div class="setting-desc">Invia copia del log nei DM dell'utente</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tickSendDmTranscript" <%= config.tickets?.sendDmTranscript ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Registro Canale Log</div>
                <div class="setting-desc">Invia notifica di apertura/chiusura nel log</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tickSendLog" <%= config.tickets?.sendLog ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Mostra Icona Avatar</div>
                <div class="setting-desc">Mostra avatar dell'utente nell'embed</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tickShowThumb" <%= config.tickets?.showThumbnail ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Canale Transcript & Log:</label>
              <select id="tickTranscriptChannel" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Seleziona canale transcript --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.tickets?.transcriptChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Categoria Ticket:</label>
              <select id="tickCategoryChannel" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Nessuna (crea nella root) --</option>
                <% (categories || []).forEach(c => { %>
                  <option value="<%= c.id %>" <%= config.tickets?.panels?.[0]?.categoryId === c.id ? 'selected' : '' %>>[Categoria] <%= c.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Ruolo Staff Ticket:</label>
              <select id="tickStaffRole" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Chiunque con Gestisci Canali --</option>
                <% (roles || []).forEach(r => { %>
                  <option value="<%= r.id %>" <%= (config.tickets?.panels?.[0]?.viewRoles || []).includes(r.id) ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <!-- TICKET EMBED CUSTOMIZATION -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-paintbrush"></i> Personalizzazione Embed di Benvenuto & Chiusura</div>
              <div class="card-desc">Modifica i titoli, i colori, i footer e i messaggi inviati nei ticket e nei DM.</div>
            </div>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Titolo Embed Benvenuto:</label>
              <input type="text" id="tickWelcomeTitle" class="form-control" value="<%= config.tickets?.welcomeEmbedTitle || 'Supporto RoomUp' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Embed Benvenuto:</label>
              <div class="color-picker-group">
                <input type="color" id="tickWelcomeColor" value="<%= config.tickets?.welcomeEmbedColor || '#5865F2' %>" class="color-picker-input" onchange="document.getElementById('tickWelcomeColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="tickWelcomeColorHex" class="form-control" value="<%= config.tickets?.welcomeEmbedColor || '#5865F2' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('tickWelcomeColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Footer Embed Benvenuto:</label>
              <input type="text" id="tickWelcomeFooter" class="form-control" value="<%= config.tickets?.welcomeEmbedFooter || 'Un membro dello staff ti risponderà a breve' %>" oninput="markUnsavedChanges()">
            </div>
          </div>

          <div class="grid-3" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Titolo Embed Chiusura:</label>
              <input type="text" id="tickCloseTitle" class="form-control" value="<%= config.tickets?.closeEmbedTitle || 'Ticket Chiuso' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Embed Chiusura:</label>
              <div class="color-picker-group">
                <input type="color" id="tickCloseColor" value="<%= config.tickets?.closeEmbedColor || '#e74c3c' %>" class="color-picker-input" onchange="document.getElementById('tickCloseColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="tickCloseColorHex" class="form-control" value="<%= config.tickets?.closeEmbedColor || '#e74c3c' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('tickCloseColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Notifica DM di Chiusura:</label>
              <input type="text" id="tickCloseDmMsg" class="form-control" value="<%= config.tickets?.closeDmMessage || 'Il tuo ticket in {guild} è stato archiviato.' %>" oninput="markUnsavedChanges()">
              <div style="margin-top: 0.3rem;">
                <span class="var-chip" onclick="insertVar('tickCloseDmMsg', '{guild}')">{guild}</span>
                <span class="var-chip" onclick="insertVar('tickCloseDmMsg', '{ticketId}')">{ticketId}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Dispatch Panel Box -->
        <div class="dashboard-card" style="border: 1px dashed var(--primary);">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-paper-plane"></i> Invia Pannello Ticket nel Canale</div>
              <div class="card-desc">Scegli il canale dove pubblicare il messaggio per aprire ticket.</div>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
              <label class="form-label">Canale:</label>
              <select id="sendTicketChannelId" class="form-control">
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>"># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>
            <button class="btn-save" type="button" onclick="dispatchTicketPanel()"><i class="fa-solid fa-paper-plane"></i> Invia Pannello</button>
          </div>
        </div>
      </div>

      <!-- ================= TAB: VERIFICATION ================= -->
      <div id="tab-verification" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
              <h2 class="sub-title">Verifica Membri & Captcha</h2>
              <p class="sub-desc">Proteggi il server da bot e raid con verifica tramite pulsante o codice Captcha.</p>
            </div>
          </div>
          
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-sliders"></i> Regole di Verifica</div>
              <div class="card-desc">Configura il canale e il ruolo da assegnare dopo la verifica.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="verEnabled" <%= config.verification?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Canale di Verifica:</label>
              <select id="verChannelId" class="form-control">
                <option value="">-- Seleziona canale --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.verification?.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Ruolo da Assegnare:</label>
              <select id="verRoleId" class="form-control">
                <option value="">-- Seleziona ruolo --</option>
                <% (roles || []).forEach(r => { %>
                  <option value="<%= r.id %>" <%= (config.verification?.verifiedRoleId === r.id || config.verification?.roleToAddId === r.id) ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Tipo di Verifica:</label>
              <select id="verMode" class="form-control">
                <option value="code" <%= config.verification?.mode === 'code' ? 'selected' : '' %>>Codice Captcha</option>
                <option value="button" <%= config.verification?.mode === 'button' ? 'selected' : '' %>>Pulsante Singolo (1-Click)</option>
                <option value="math" <%= config.verification?.mode === 'math' ? 'selected' : '' %>>Calcolo Matematico</option>
                <option value="emoji" <%= config.verification?.mode === 'emoji' ? 'selected' : '' %>>Emoji Puzzle</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Testo del Pulsante:</label>
              <input type="text" id="verButtonLabel" class="form-control" value="<%= config.verification?.buttonLabel || 'Verificati Ora' %>">
            </div>
          </div>

          <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
            <div>
              <div style="font-weight: 800; font-size: 0.95rem; color: var(--text-main);">Nascondi canale dopo la verifica</div>
              <div style="font-size: 0.8rem; color: var(--text-muted);">Nasconde il canale di verifica all'utente una volta verificato con successo.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="verHideChannel" <%= config.verification?.hideChannelAfterVerify ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>

          <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
            <div>
              <div style="font-weight: 800; font-size: 0.95rem; color: var(--text-main);">Nascondi tutti i canali ai non verificati (Isolamento Membri)</div>
              <div style="font-size: 0.8rem; color: var(--text-muted);">Isola direttamente l'ID dei singoli membri non verificati nascondendo i canali. ZERO modifiche a @everyone! Quando l'utente si verifica, i permessi vengono rimossi e i canali compaiono all'istante.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="verHideAllChannels" <%= config.verification?.hideAllChannelsUntilVerified ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <!-- VERIFICATION EMBED DESIGN BUILDER -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-paintbrush"></i> Design Visivo & Personalizzazione Embed</div>
              <div class="card-desc">Personalizza titolo, descrizione, colori, icone, banner e pulsanti dell'embed di verifica.</div>
            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Titolo Embed di Verifica:</label>
              <input type="text" id="verEmbedTitle" class="form-control" value="<%= config.verification?.embedTitle || 'Verifica del Server' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Barra Laterale Embed:</label>
              <div class="color-picker-group">
                <input type="color" id="verColor" value="<%= config.verification?.embedColor || '#5865F2' %>" class="color-picker-input" onchange="document.getElementById('verColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="verColorHex" class="form-control form-control-mono" value="<%= config.verification?.embedColor || '#5865F2' %>" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('verColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Testo Footer (Piè di Pagina):</label>
              <input type="text" id="verFooterText" class="form-control" value="<%= config.verification?.embedFooter || 'Sistema di Protezione RoomUp!' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore / Stile Pulsante Discord:</label>
              <select id="verButtonColor" class="form-control" onchange="markUnsavedChanges()">
                <option value="success" <%= (!config.verification?.buttonColor || config.verification?.buttonColor === 'success') ? 'selected' : '' %>>🟢 Verde (Success)</option>
                <option value="primary" <%= config.verification?.buttonColor === 'primary' ? 'selected' : '' %>>🔵 Blu Discord (Primary)</option>
                <option value="secondary" <%= config.verification?.buttonColor === 'secondary' ? 'selected' : '' %>>⚪ Grigio Scuro (Secondary)</option>
                <option value="danger" <%= config.verification?.buttonColor === 'danger' ? 'selected' : '' %>>🔴 Rosso (Danger)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">URL Icona Thumbnail (In alto a destra):</label>
              <input type="text" id="verThumbnail" class="form-control" placeholder="https://i.imgur.com/... o vuoto" value="<%= config.verification?.thumbnail || '' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">URL Immagine / Banner Grande:</label>
              <input type="text" id="verImage" class="form-control" placeholder="https://i.imgur.com/... o vuoto" value="<%= config.verification?.image || '' %>" oninput="markUnsavedChanges()">
            </div>
          </div>

          <div class="form-group" style="margin-top: 1rem;">
            <label class="form-label">Descrizione / Testo dell'Embed di Verifica:</label>
            <textarea id="verEmbedDesc" class="form-control" style="min-height: 90px;" oninput="markUnsavedChanges()"><%= config.verification?.embedDescription || config.verification?.description || 'Clicca sul pulsante sottostante per verificare il tuo account e sbloccare tutti i canali del server!' %></textarea>
            <div style="margin-top: 0.4rem;">
              <span class="var-chip" onclick="insertVar('verEmbedDesc', '{user}')">{user}</span>
              <span class="var-chip" onclick="insertVar('verEmbedDesc', '{username}')">{username}</span>
              <span class="var-chip" onclick="insertVar('verEmbedDesc', '{guild}')">{guild}</span>
              <span class="var-chip" onclick="insertVar('verEmbedDesc', '{memberCount}')">{memberCount}</span>
            </div>
          </div>
        </div>

        <!-- VERIFICATION RESPONSE MESSAGES & NOTIFICATIONS -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-message"></i> Messaggi di Risposta & Notifiche Utente</div>
              <div class="card-desc">Personalizza i messaggi mostrati all'utente all'avvio, al successo, in caso di errore o in privato (DM).</div>
            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Messaggio di Verifica Riuscita (Successo):</label>
              <input type="text" id="verSuccessMsg" class="form-control" value="<%= config.verification?.successMessage || 'Hai completato la verifica con successo! Benvenuto in **{guild}**.{roles}' %>" oninput="markUnsavedChanges()">
              <div style="margin-top: 0.3rem;">
                <span class="var-chip" onclick="insertVar('verSuccessMsg', '{user}')">{user}</span>
                <span class="var-chip" onclick="insertVar('verSuccessMsg', '{username}')">{username}</span>
                <span class="var-chip" onclick="insertVar('verSuccessMsg', '{guild}')">{guild}</span>
                <span class="var-chip" onclick="insertVar('verSuccessMsg', '{roles}')">{roles}</span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Messaggio Risposta Errata / Errore:</label>
              <input type="text" id="verFailMsg" class="form-control" value="<%= config.verification?.failMessage || 'Risposta non corretta! (Tentativo {attempt}/{maxAttempts}). Riprova cliccando nuovamente sul pulsante.' %>" oninput="markUnsavedChanges()">
              <div style="margin-top: 0.3rem;">
                <span class="var-chip" onclick="insertVar('verFailMsg', '{attempt}')">{attempt}</span>
                <span class="var-chip" onclick="insertVar('verFailMsg', '{maxAttempts}')">{maxAttempts}</span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Messaggio Già Verificato:</label>
              <input type="text" id="verAlreadyVerifiedMsg" class="form-control" value="<%= config.verification?.alreadyVerifiedMessage || '✅ Sei già verificato in questo server!' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Messaggio Sessione Scaduta:</label>
              <input type="text" id="verExpiredMsg" class="form-control" value="<%= config.verification?.sessionExpiredMessage || 'La sessione di verifica è scaduta. Riprova cliccando nuovamente sul pulsante.' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
              <label class="form-label">Messaggio Verifica Temporaneamente Disattivata:</label>
              <input type="text" id="verDisabledMsg" class="form-control" value="<%= config.verification?.disabledMessage || '⚠️ Il sistema di verifica è temporaneamente disattivato dall\'amministratore.' %>" oninput="markUnsavedChanges()">
            </div>
          </div>

          <!-- DM Notification Sub-box -->
          <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <div>
                <div style="font-weight: 800; font-size: 0.95rem; color: var(--text-main);">Invia Notifica Privata in DM all'Utente</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Invia un messaggio diretto di benvenuto all'utente non appena supera la verifica.</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="verDmNotification" <%= config.verification?.dmNotification ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>
            <div class="form-group">
              <label class="form-label">Testo del Messaggio Privato (DM):</label>
              <textarea id="verDmMsg" class="form-control" style="min-height: 70px;" oninput="markUnsavedChanges()"><%= config.verification?.dmMessage || 'Ciao {username}! Hai completato con successo la verifica in **{guild}**.{roles}\nBuona permanenza!' %></textarea>
              <div style="margin-top: 0.3rem;">
                <span class="var-chip" onclick="insertVar('verDmMsg', '{user}')">{user}</span>
                <span class="var-chip" onclick="insertVar('verDmMsg', '{username}')">{username}</span>
                <span class="var-chip" onclick="insertVar('verDmMsg', '{guild}')">{guild}</span>
                <span class="var-chip" onclick="insertVar('verDmMsg', '{roles}')">{roles}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- VERIFICATION SECURITY, PUNISHMENTS & AUDIT LOG -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-shield-halved"></i> Sicurezza Avanzata Anti-Alt, Sanzioni & Audit Log</div>
              <div class="card-desc">Imposta requisiti per nuovi account, sanzioni in caso di fallimenti ripetuti e canale per i registri.</div>
            </div>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Tentativi Massimi Consentiti:</label>
              <input type="number" id="verMaxFails" class="form-control" min="1" max="10" value="<%= config.verification?.maxFailedAttempts || 3 %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Azione al Superamento Limite:</label>
              <select id="verFailedAction" class="form-control" onchange="markUnsavedChanges()">
                <option value="kick" <%= (!config.verification?.failedAction || config.verification?.failedAction === 'kick') ? 'selected' : '' %>>Espulsione (Kick)</option>
                <option value="timeout" <%= config.verification?.failedAction === 'timeout' ? 'selected' : '' %>>Muto Temporaneo (Timeout 1h)</option>
                <option value="ban" <%= config.verification?.failedAction === 'ban' ? 'selected' : '' %>>Bando Permanente (Ban)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Età Minima Account (Giorni):</label>
              <input type="number" id="verMinAccountAge" class="form-control" min="0" max="365" value="<%= config.verification?.minAccountAgeDays || 0 %>" oninput="markUnsavedChanges()">
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Messaggio Sanzione per Tentativi Esauriti:</label>
              <input type="text" id="verPunishmentMsg" class="form-control" value="<%= config.verification?.punishmentMessage || 'Hai superato il limite di tentativi consentiti ({maxAttempts}). Sei stato {action}.' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Messaggio Rifiuto Età Minima Account:</label>
              <input type="text" id="verMinAgeMsg" class="form-control" value="<%= config.verification?.minAgeMessage || 'Accesso negato: Il tuo account è troppo recente ({age} giorni). Il server richiede almeno {minDays} giorni di anzianità.' %>" oninput="markUnsavedChanges()">
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="setting-item-box" style="margin-bottom: 0;">
              <div>
                <div class="setting-title">Richiedi Avatar Personalizzato</div>
                <div class="setting-desc">Blocca utenti con l'immagine di default di Discord</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="verRequireAvatar" <%= config.verification?.requireAvatar ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box" style="margin-bottom: 0;">
              <div>
                <div class="setting-title">Invia Audit Log nel Canale</div>
                <div class="setting-desc">Registra tutte le verifiche superate e fallite</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="verSendChannelLog" <%= config.verification?.sendChannelLog ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div class="grid-2" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Messaggio Rifiuto Senza Avatar:</label>
              <input type="text" id="verRequireAvatarMsg" class="form-control" value="<%= config.verification?.requireAvatarMessage || 'Accesso negato: Il server richiede un account con un\'immagine del profilo personalizzata.' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Canale Audit Log Verifiche:</label>
              <select id="verLogChannel" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Nessun canale selezionato --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.verification?.logChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>
          </div>
        </div>

        <!-- Channel Isolation Management Card -->
        <div class="dashboard-card" style="border: 1px solid var(--border);">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-user-shield"></i> Isolamento Membri Non Verificati (Zero @everyone)</div>
              <div class="card-desc">Applica o rimuove i permessi di isolamento direttamente sugli ID dei membri non verificati (lasciando @everyone intatto).</div>
            </div>
          </div>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem;">
            <button class="btn-save" style="background: var(--accent-purple);" type="button" onclick="isolateServerChannels()"><i class="fa-solid fa-user-lock"></i> 🔒 Isola Membri Non Verificati Ora</button>
            <button class="btn-save" style="background: var(--bg-hover); color: var(--text-main); border: 1px solid var(--border);" type="button" onclick="resetServerChannelIsolation()"><i class="fa-solid fa-user-check"></i> 🔓 Rimuovi Isolamento Membri</button>
          </div>
        </div>

        <!-- Dispatch Verification Box -->
        <div class="dashboard-card" style="border: 1px dashed var(--accent-cyan);">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-paper-plane"></i> Invia Messaggio di Verifica</div>
              <div class="card-desc">Invia il messaggio con il pulsante nel canale di verifica.</div>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
              <label class="form-label">Canale:</label>
              <select id="sendVerifyChannelId" class="form-control">
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.verification?.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>
            <button class="btn-save" style="background: var(--accent-cyan);" type="button" onclick="dispatchVerifyPanel()"><i class="fa-solid fa-paper-plane"></i> Invia Messaggio</button>
          </div>
        </div>
      </div>

      <!-- ================= TAB: WELCOME & LEAVE ================= -->
      <div id="tab-welcome" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-door-open"></i>
            </div>
            <div>
              <h2 class="sub-title">Benvenuto & Arrivi</h2>
              <p class="sub-desc">Messaggi di benvenuto e addio con card grafiche dinamiche, DM di benvenuto e ruoli automatici.</p>
            </div>
          </div>
          <div class="sub-header-right">
            <button type="button" class="btn-primary" onclick="dispatchTestWelcome()" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700;">
              <i class="fa-solid fa-flask"></i> 🧪 Invia Test Benvenuto in Chat
            </button>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-hand-wave"></i> Messaggio di Benvenuto nel Canale</div>
              <div class="card-desc">Personalizza ogni aspetto visivo, testuale e le notifiche di benvenuto.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="welEnabled" <%= config.welcome?.enabled ? 'checked' : '' %> onchange="markUnsavedChanges()">
              <span class="slider"></span>
            </label>
          </div>

          <!-- Toggles Grid -->
          <div class="grid-3" style="margin-bottom: 1.25rem;">
            <div class="setting-item-box">
              <div>
                <div class="setting-title">Invia nel Canale</div>
                <div class="setting-desc">Pubblica il messaggio nel canale scelto</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="welSendChannel" <%= config.welcome?.sendChannelMessage !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Auto-Elimina se Esce</div>
                <div class="setting-desc">Cancella il benvenuto se l'utente abbandona il server</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="welAutoDelete" <%= config.welcome?.autoDeleteOnLeave !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Barra Gradiente Divisorio</div>
                <div class="setting-desc">Mostra la barra sfumata personalizzata sotto l'embed</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="welDividerBar" <%= config.welcome?.useDividerBar !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Usa Embed Ricco</div>
                <div class="setting-desc">Formato card moderna anziché solo testo</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="welUseEmbed" <%= config.welcome?.useEmbed !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Menziona Utente (Ping)</div>
                <div class="setting-desc">Pinga l'utente per attirare l'attenzione</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="welPing" <%= config.welcome?.pingUser !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Mostra Miniatura (Thumbnail)</div>
                <div class="setting-desc">Icona in alto a destra nell'embed</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="welThumb" <%= config.welcome?.showThumbnail !== false ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <!-- Inputs Grid -->
          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Canale di Benvenuto:</label>
              <select id="welChannelId" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Seleziona canale --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.welcome?.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Soggetto Miniatura (Thumbnail):</label>
              <select id="welThumbMode" class="form-control" onchange="markUnsavedChanges()">
                <option value="guild" <%= (config.welcome?.thumbnailMode || 'guild') === 'guild' ? 'selected' : '' %>>Icona del Server (Consigliato - come screenshot)</option>
                <option value="user" <%= config.welcome?.thumbnailMode === 'user' ? 'selected' : '' %>>Avatar Profilo Utente Discord</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Titolo Embed:</label>
              <input type="text" id="welEmbedTitle" class="form-control" value="<%= config.welcome?.embedTitle || 'Benvenuto su {guild}!' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Barra Embed:</label>
              <div class="color-picker-group">
                <input type="color" id="welColor" value="<%= config.welcome?.embedColor || '#731FC3' %>" class="color-picker-input" onchange="document.getElementById('welColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="welColorHex" class="form-control" value="<%= config.welcome?.embedColor || '#731FC3' %>" class="form-control form-control-mono" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('welColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Testo Footer Embed:</label>
              <input type="text" id="welFooterText" class="form-control" value="<%= config.welcome?.embedFooterText || 'Membro #{memberCount}' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Messaggio Chat Esterno (con Ping):</label>
              <input type="text" id="welChatMessage" class="form-control" value="<%= config.welcome?.chatMessage || config.welcome?.message || 'Benvenuto {user} nella nostra community {guild}!' %>" oninput="markUnsavedChanges()">
            </div>
          </div>

          <div class="form-group" style="margin-top: 1rem;">
