              <input type="checkbox" id="levEnabled" <%= config.levels?.enabled ? 'checked' : '' %> onchange="markUnsavedChanges()">
              <span class="slider"></span>
            </label>
          </div>

          <div class="grid-3" style="margin-bottom: 1.25rem;">
            <div class="setting-item-box">
              <div>
                <div class="setting-title">XP con Messaggi</div>
                <div class="setting-desc">Assegna XP per ogni messaggio in chat</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="levGainText" <%= config.levels?.gainXpText ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">XP Canali Vocali</div>
                <div class="setting-desc">Assegna XP per il tempo trascorso in vocale</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="levGainVoice" <%= config.levels?.gainXpVoice ? 'checked' : '' %> onchange="markUnsavedChanges()">
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">XP da Mutato / Sordina</div>
                <div class="setting-desc">Assegna XP anche se l'utente è mutato o con le cuffie disattivate</div>
