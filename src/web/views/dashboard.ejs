    // AI Moderator: Test Simulation in Playground
    async function testAiSimulation() {
      const text = getVal('aiSimulateInput');
      if (!text) {
        showToast("Inserisci un messaggio da testare", true);
        return;
      }

      const resBox = document.getElementById('aiSimulateResultBox');
      const titleEl = document.getElementById('aiSimVerdictTitle');
      const badgeEl = document.getElementById('aiSimSuspicionBadge');
      const barEl = document.getElementById('aiSimBar');
      const issuesList = document.getElementById('aiSimIssuesList');
      const detailEl = document.getElementById('aiSimDecisionDetail');

      if (resBox) resBox.style.display = 'block';
      if (titleEl) titleEl.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Analisi in corso...`;

      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/aimod/simulate`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ text })
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);

        const r = data.result;
        if (badgeEl) badgeEl.innerText = `${r.suspicion}% Sospetto`;
        if (barEl) barEl.style.width = `${r.suspicion}%`;

        if (issuesList) {
          issuesList.innerHTML = "";
          if (r.detectedIssues && r.detectedIssues.length > 0) {
            r.detectedIssues.forEach(iss => {
              const li = document.createElement('li');
              li.innerText = iss;
              issuesList.appendChild(li);
            });
          } else {
            issuesList.innerHTML = `<li style="color: #5865F2;">Nessun problema rilevato.</li>`;
          }
        }

        if (r.decision === "autonomous_timeout" || r.decision === "autonomous_delete") {
          if (titleEl) titleEl.innerHTML = `<span style="color: var(--accent-red);"><i class="fa-solid fa-ban"></i> AZIONE: ELIMINAZIONE & TIMEOUT</span>`;
          if (badgeEl) badgeEl.style.color = "var(--accent-red)";
          if (barEl) barEl.style.backgroundColor = "var(--accent-red)";
          if (detailEl) detailEl.innerText = `Violazione rilevata (${r.suspicion}%). Il bot elimina il messaggio e assegna ${r.suggestedAction === 'timeout' ? 'un timeout' : 'un avvertimento'}.`;
        } else if (r.decision === "escalate_to_staff") {
          if (titleEl) titleEl.innerHTML = `<span style="color: var(--accent-yellow);"><i class="fa-solid fa-circle-question"></i> RICHIESTA PARERE STAFF</span>`;
          if (badgeEl) badgeEl.style.color = "var(--accent-yellow)";
          if (barEl) barEl.style.backgroundColor = "var(--accent-yellow)";
          if (detailEl) detailEl.innerText = `Dubbio dell'AI (${r.suspicion}%): richiesta inviata nel canale dello Staff.`;
        } else {
          if (titleEl) titleEl.innerHTML = `<span style="color: #5865F2;"><i class="fa-solid fa-circle-check"></i> MESSAGGIO CONSENTITO</span>`;
          if (badgeEl) badgeEl.style.color = "#5865F2";
          if (barEl) barEl.style.backgroundColor = "#5865F2";
          if (detailEl) detailEl.innerText = `Nessuna infrazione (${r.suspicion}%). Il messaggio è regolare.`;
        }
      } catch (e) {
        if (titleEl) titleEl.innerHTML = `<span style="color: var(--accent-red);">Errore: ${e.message}</span>`;
      }
    }

    // Custom Commands Management (Interactive)
    async function addCustomCommand() {
      const trigger = getVal('newCmdTrigger');
      const response = getVal('newCmdResponse');
      const title = getVal('newCmdTitle');
      const useEmbed = getChecked('newCmdEmbed');

      if (!trigger || !response) {
        showToast("Inserisci comando e risposta", true);
        return;
      }

      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/custom-commands/add`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ trigger, response, title, useEmbed })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Comando aggiunto!");
          document.getElementById('newCmdTrigger').value = "";
          document.getElementById('newCmdResponse').value = "";
          document.getElementById('newCmdTitle').value = "";
          document.getElementById('newCmdEmbed').checked = false;

          document.getElementById('noCustomCmdRow')?.remove();
          const tbody = document.getElementById('customCommandsTableBody');
          if (tbody) {
            const tr = document.createElement('tr');
            tr.id = `row_cmd_${data.command.id}`;
            tr.innerHTML = `
              <td><code>${data.command.trigger}</code></td>
              <td>${data.command.response}</td>
              <td><span style="color: var(--primary); font-weight: 800;">${data.command.useEmbed ? 'EMBED' : 'TESTO'}</span></td>
              <td style="text-align: right;">
                <button type="button" class="btn-danger" onclick="deleteCustomCommand('${data.command.id}')"><i class="fa-solid fa-trash"></i></button>
              </td>
            `;
            tbody.appendChild(tr);
          }
        } else {
          showToast(data.message, true);
        }
      } catch (e) {
        showToast("Errore creazione comando", true);
      }
    }

    async function deleteCustomCommand(triggerId) {
      if (!confirm("Vuoi eliminare questo comando?")) return;
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/custom-commands/delete`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ triggerId })
        });
        const data = await res.json();
        if (data.success) {
          const row = document.getElementById(`row_cmd_${triggerId}`) || document.getElementById(`row_cmd_${triggerId.replace(/[^a-zA-Z0-9]/g, '_')}`);
