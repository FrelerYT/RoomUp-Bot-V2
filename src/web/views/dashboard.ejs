                  <strong style="color: var(--text-main); font-size: 0.88rem;">${escapeHtml(item.title || 'Nuova regola osservata dallo staff')}</strong>
                </div>
                <div style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.4;">${escapeHtml(item.rule || item.learnedData || '')}</div>
                <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 0.35rem;">Osservato da: <em>${escapeHtml(item.staffUser || 'Staff')}</em> nel ticket #${escapeHtml(item.ticketId || '')}</div>
              </div>
              <div style="display: flex; gap: 0.5rem;">
                <button type="button" class="btn btn-primary btn-sm" onclick="approveSentinelLearning('${item.id}')"><i class="fa-solid fa-check"></i> Approva</button>
                <button type="button" class="btn btn-outline btn-sm" onclick="rejectSentinelLearning('${item.id}')"><i class="fa-solid fa-xmark"></i> Scarta</button>
              </div>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<div style="text-align: center; color: var(--text-dim); padding: 1.5rem;"><i class="fa-solid fa-circle-check" style="color: #2ecc71; margin-right: 0.4rem;"></i> Coda vuota: tutte le procedure osservate sono state revisionate.</div>';
        }
      } catch (err) {
        container.innerHTML = '<div style="text-align: center; color: #ef4444; padding: 1rem;">Errore caricamento coda di apprendimento.</div>';
      }
    }

    async function approveSentinelLearning(eventId) {
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/learning/approve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ eventId })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          await Promise.all([loadSentinelLearningQueue(), loadSentinelKnowledge()]);
        } else {
          showToast(data.message || 'Errore approvazione', true);
        }
      } catch (err) {
        showToast('Errore: ' + err.message, true);
      }
    }

    async function rejectSentinelLearning(eventId) {
      const reason = prompt('Motivo del rifiuto (opzionale):', 'Non conforme alle policy del server');
      if (reason === null) return;
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/learning/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ eventId, reason })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          await loadSentinelLearningQueue();
        } else {
          showToast(data.message || 'Errore rifiuto', true);
        }
      } catch (err) {
        showToast('Errore: ' + err.message, true);
      }
    }

    function exportSentinelMemory() {
      window.open(`/api/dashboard/${GUILD_ID}/sentinel/memory/export`, '_blank');
    }

    async function clearSentinelMemory() {
      if (!confirm('ATTENZIONE: Stai per cancellare l\'intera memoria procedurale isolata di questo server. Confermi?')) return;
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/memory/clear`, {
          method: 'POST'
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
        } else {
          showToast('Errore reset memoria', true);
        }
      } catch (err) {
        showToast('Errore: ' + err.message, true);
      }
    }

    async function runSentinelSim() {
      const type = document.getElementById('sentinelSimType')?.value || 'message';
      const inputVal = document.getElementById('sentinelSimInput')?.value?.trim();
      const resContainer = document.getElementById('sentinelSimResult');
      if (!resContainer) return;

      if (!inputVal) {
        showToast('Inserisci un testo da simulare!', true);
        return;
      }

      resContainer.textContent = 'Simulazione neurale in corso...';

      try {
        const payload = { type };
        if (type === 'ticket') payload.problem = inputVal;
        else if (type === 'staff_takeover') payload.staffPhrase = inputVal;
        else payload.content = inputVal;

        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/simulate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          resContainer.textContent = JSON.stringify(data.result, null, 2);
          showToast('Simulazione completata!');
        } else {
          resContainer.textContent = 'Errore simulazione: ' + (data.error || 'Risultato non disponibile');
          showToast('Errore durante la simulazione', true);
        }
      } catch (err) {
        resContainer.textContent = 'Errore di connessione: ' + err.message;
        showToast('Errore di connessione', true);
      }
    }

  </script>

  <!-- ================= COMMAND PALETTE (CTRL+K) ================= -->
  <div id="cmdPaletteModal" class="modal-overlay" onclick="handlePaletteBackdrop(event)">
    <div class="cmd-palette-container" onclick="event.stopPropagation()">
      <div class="cmd-palette-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="cmdPaletteInput" class="cmd-palette-input" placeholder="Digita per cercare comandi, canali, moduli o impostazioni..." autocomplete="off">
        <span class="cmd-palette-esc" onclick="closeCmdPalette()">ESC</span>
      </div>
      <div class="cmd-palette-results" id="cmdPaletteResults">
        <!-- Results populated dynamically by JavaScript -->
      </div>
      <div class="cmd-palette-footer">
        <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> per navigare</span>
        <span><kbd>Enter</kbd> per selezionare</span>
        <span><kbd>ESC</kbd> per chiudere</span>
      </div>
    </div>
  </div>

</body>
</html>
