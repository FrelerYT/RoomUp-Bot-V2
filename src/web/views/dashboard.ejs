    .var-chip { display: inline-block; background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 6px; padding: 0.18rem 0.5rem; font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; color: var(--text-muted); cursor: pointer; margin-right: 0.35rem; margin-top: 0.35rem; transition: all 0.15s; }
    .var-chip:hover { background: rgba(255,255,255,0.08); border-color: var(--border-hover); color: var(--text-main); }

    /* Toast */
    #toast {
      visibility: hidden;
      min-width: 260px;
      background-color: #18191f;
      border: 1px solid rgba(88, 101, 242, 0.35);
      color: var(--text-main);
