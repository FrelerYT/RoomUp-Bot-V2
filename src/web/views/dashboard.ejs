          </div>

          <div class="form-group" style="margin-top: 1rem;">
            <label class="form-label">Messaggio di Congratulazioni:</label>
            <input type="text" id="levMessage" class="form-control" value="<%= config.levels?.message || 'Congratulazioni {user}! Sei salito al **Livello {level}**!' %>" oninput="markUnsavedChanges()">
            <div style="margin-top: 0.4rem;">
