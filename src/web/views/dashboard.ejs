              <div id="sentinelSimResult" style="background: var(--bg-input); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border); font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--text-muted); min-height: 50px;">
                I risultati della simulazione compariranno qui...
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ================= TAB: AUDIT LOGS ================= -->
      <div id="tab-logs" class="tab-pane">
        <div class="sub-header">
          <div class="sub-header-left">
            <div class="header-icon supercircle">
              <i class="fa-solid fa-list-check"></i>
            </div>
            <div>
              <h2 class="sub-title">Registro Audit & Log Eventi</h2>
              <p class="sub-desc">Tracciamento completo e granulare di ogni evento del server in canali dedicati.</p>
            </div>
          </div>
        </div>

        <div class="master-controls">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="search-input" id="eventSearch" placeholder="Cerca un evento..." onkeyup="filterEvents()">
          </div>

          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <label class="form-label" style="margin: 0;">Canale Predefinito:</label>
            <select id="logsGlobalChannel" class="form-control" style="width: auto; min-width: 220px;">
              <option value="">-- Nessun canale globale --</option>
              <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                <optgroup label="<%= groupName %>">
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= config.logs?.globalChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>

          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 0.85rem; font-weight: 800; color: var(--text-muted);">ATTIVO:</span>
            <label class="switch">
              <input type="checkbox" id="logsMasterToggle" <%= config.logs?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <!-- Categories & Events Matrix -->
        <% (allCategories || []).forEach(cat => { %>
          <% const catConfig = (config.logs?.categories && config.logs.categories[cat.id]) ? config.logs.categories[cat.id] : {}; %>
          <div class="category-card" data-cat="<%= cat.id %>">
            <div class="category-header">
              <div class="category-header-title">
                <i class="<%= cat.icon %>"></i> <%= cat.title %>
              </div>
              <div class="category-header-actions">
                <select class="cat-channel-select form-control" style="width: auto; font-size: 0.82rem; padding: 0.4rem 0.75rem;" data-cat="<%= cat.id %>">
                  <option value="">-- Canale Intera Categoria --</option>
                  <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                    <optgroup label="<%= groupName %>">
                      <% channels.forEach(ch => { %>
                        <option value="<%= ch.id %>" <%= catConfig.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                      <% }) %>
                    </optgroup>
                  <% } %>
                </select>
                <label class="switch" title="Attiva/Disattiva categoria">
                  <input type="checkbox" class="cat-toggle" data-cat="<%= cat.id %>" <%= catConfig.enabled ? 'checked' : '' %>>
                  <span class="slider"></span>
                </label>
              </div>
            </div>

            <div class="events-container">
              <% (cat.events || []).forEach(evt => { %>
                <% const evtConfig = (config.logs?.events && config.logs.events[evt.key]) ? config.logs.events[evt.key] : {}; %>
                <div class="event-wrapper" data-event-key="<%= evt.key %>">
                  <div class="event-row">
                    <div class="event-meta">
                      <h4><%= evt.label %> <span class="badge-tag">[<%= evt.key %>]</span></h4>
                      <p><%= evt.desc %></p>
                    </div>
                    <div class="event-controls">
                      <select class="event-channel-select form-control" style="width: auto; font-size: 0.82rem; padding: 0.4rem 0.75rem;" data-event="<%= evt.key %>">
                        <option value="">-- Eredita Categoria / Globale --</option>
                        <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                          <optgroup label="<%= groupName %>">
                            <% channels.forEach(ch => { %>
                              <option value="<%= ch.id %>" <%= evtConfig.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                            <% }) %>
                          </optgroup>
                        <% } %>
                      </select>
                      <button type="button" class="btn-gear" onclick="toggleCustomPanel('<%= evt.key %>')" title="Personalizza Embed"><i class="fa-solid fa-gear"></i></button>
                      <label class="switch">
                        <input type="checkbox" class="event-toggle" data-event="<%= evt.key %>" <%= evtConfig.enabled ? 'checked' : '' %>>
                        <span class="slider"></span>
                      </label>
                    </div>
                  </div>

                  <!-- Customizer Drawer -->
                  <div class="event-custom-panel" id="panel_<%= evt.key %>">
                    <div class="grid-2">
                      <div>
                        <label class="form-label">Titolo Notifica Embed Personalizzato</label>
                        <input type="text" class="form-control custom-title-input" data-event="<%= evt.key %>" value="<%= evtConfig.customTitle || '' %>" placeholder="Es. Sanzione Applicata">
                      </div>
                      <div>
                        <label class="form-label">Colore Barra Embed</label>
                        <input type="color" class="custom-color-input color-picker-input" data-event="<%= evt.key %>" value="<%= evtConfig.customColor || '#5865F2' %>">
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>

      <div id="tab-giveaways" class="tab-pane">
