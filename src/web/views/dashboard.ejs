            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Titolo Embed Partnership:</label>
              <input type="text" id="partEmbedTitle" class="form-control" value="<%= config.partnerships?.embedTitle || '🤝 Nuova Partnership Ufficiale!' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">Colore Barra Laterale Embed:</label>
              <div class="color-picker-group">
                <input type="color" id="partColor" value="<%= config.partnerships?.embedColor || '#5865F2' %>" class="color-picker-input" onchange="document.getElementById('partColorHex').value = this.value; markUnsavedChanges();">
                <input type="text" id="partColorHex" class="form-control form-control-mono" value="<%= config.partnerships?.embedColor || '#5865F2' %>" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)){document.getElementById('partColor').value = this.value;} markUnsavedChanges();">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Testo Footer Embed:</label>
              <input type="text" id="partFooterText" class="form-control" value="<%= config.partnerships?.embedFooter || 'RoomUp! Network • Partnership System' %>" oninput="markUnsavedChanges()">
            </div>

            <div class="form-group">
              <label class="form-label">URL Icona / Thumbnail (opzionale):</label>
              <input type="text" id="partThumb" class="form-control" placeholder="https://i.imgur.com/... o vuoto" value="<%= config.partnerships?.thumbnail || '' %>" oninput="markUnsavedChanges()">
