    .metric-label, .stat-card-title {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      text-align: center !important;
      width: 100%;
      margin: 0;
      display: block;
