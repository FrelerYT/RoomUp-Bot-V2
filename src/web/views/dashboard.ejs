                <optgroup label="<%= groupName %>">
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= config.counting?.channelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>
        </div>

        <!-- COUNTING MESSAGES CUSTOMIZATION -->
        <div class="dashboard-card">
          <div class="card-header">
            <div>
              <div class="card-title"><i class="fa-solid fa-paintbrush"></i> Personalizzazione Messaggi del Conteggio</div>
              <div class="card-desc">Modifica i testi di annuncio per errore e celebrazione traguardi.</div>
