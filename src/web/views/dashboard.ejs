          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Titolo Embed Conteggio:</label>
              <input type="text" id="countEmbedTitle" class="form-control" value="<%= config.counting?.embedTitle || '🔢 Minigioco del Conteggio' %>" oninput="markUnsavedChanges()">
