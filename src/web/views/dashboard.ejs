              </label>
            </div>

            <div class="setting-item-box">
              <div>
                <div class="setting-title">Membri Minimi in Vocale</div>
                <div class="setting-desc">Numero minimo di membri per guadagnare XP (1 = anche da solo)</div>
              </div>
              <input type="number" id="levVoiceMinMembers" min="1" max="50" style="width: 80px; text-align: center;" class="input-field" value="<%= config.levels?.voiceMinMembers !== undefined ? config.levels.voiceMinMembers : 1 %>" onchange="markUnsavedChanges()">
