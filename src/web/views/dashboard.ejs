            <div>
              <div class="metric-val" id="sentinelHealthStatus">HEALTHY</div>
              <div class="metric-lbl">Stato Globale Sistema</div>
            </div>
          </div>
          <div class="metric-box">
            <div class="metric-icon" style="background: rgba(46, 204, 113, 0.12); color: #2ecc71;"><i class="fa-solid fa-bolt"></i></div>
            <div>
              <div class="metric-val" id="sentinelAvgTime">-- ms</div>
              <div class="metric-lbl">Tempo Medio Risposta</div>
            </div>
          </div>
          <div class="metric-box">
            <div class="metric-icon" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;"><i class="fa-solid fa-brain"></i></div>
            <div>
              <div class="metric-val" id="sentinelModelActive">--</div>
              <div class="metric-lbl">Gemini Keys Attive</div>
            </div>
          </div>
          <div class="metric-box">
            <div class="metric-icon" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;"><i class="fa-solid fa-ticket"></i></div>
