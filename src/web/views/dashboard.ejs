                  <th>Autore</th>
                  <th>File Modificato</th>
                  <th>Dettaglio</th>
                </tr>
              </thead>
              <tbody id="revisionsTableBody">
                <% if (typeof revisions !== 'undefined' && Array.isArray(revisions) && revisions.length > 0) { %>
                  <% revisions.slice().reverse().slice(0, 15).forEach(rev => { %>
                    <tr>
                      <td><code><%= rev.id %></code></td>
                      <td><%= new Date(rev.timestamp).toLocaleString("it-IT") %></td>
                      <td><strong><%= rev.actor || "Staff" %></strong></td>
                      <td><code><%= rev.file %></code></td>
                      <td><%= rev.summary || "Salvataggio impostazioni" %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="empty-state">Nessuna modifica recente archiviata. Tutte le modifiche future verranno registrate qui automaticamente.</td>
