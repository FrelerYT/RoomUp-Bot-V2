                <option value="dm" <%= config.levels?.announceMode === 'dm' ? 'selected' : '' %>>Messaggio Privato (DM)</option>
                <option value="disabled" <%= config.levels?.announceMode === 'disabled' ? 'selected' : '' %>>Nessun Annuncio</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Canale annunci level up:</label>
              <select id="levChannelId" class="form-control" onchange="markUnsavedChanges()">
                <option value="">-- Seleziona canale --</option>
                <% for (const [groupName, channels] of Object.entries(groupedChannels)) { %>
                  <optgroup label="<%= groupName %>">
                    <% channels.forEach(ch => { %>
                      <option value="<%= ch.id %>" <%= config.levels?.levelUpChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
