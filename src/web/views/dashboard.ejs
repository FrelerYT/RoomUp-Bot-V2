    async function loadSentinelKnowledge() {
      const listEl = document.getElementById('sentinelKbList');
      if (!listEl) return;
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/sentinel/knowledge`);
        const data = await res.json();
        if (data.success && Array.isArray(data.items)) {
          sentinelKbCache = data.items;
          renderSentinelKnowledge(sentinelKbCache);
        } else {
          listEl.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-dim);">Nessun documento trovato.</td></tr>';
        }
      } catch (err) {
        listEl.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #ef4444;">Errore nel caricamento della Knowledge Base.</td></tr>';
      }
    }

    function renderSentinelKnowledge(items) {
      const listEl = document.getElementById('sentinelKbList');
      if (!listEl) return;
      if (!items || items.length === 0) {
        listEl.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-dim); padding: 1.5rem;">Nessun documento presente nella Knowledge Base.</td></tr>';
        return;
      }

      listEl.innerHTML = items.map(doc => {
        const catBadge = `<span class="badge" style="background: rgba(88,101,242,0.15); color: #5865F2; padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.72rem; font-weight: 700;">${doc.category || 'FAQ'}</span>`;
        const verBadge = `<span class="badge" style="background: rgba(255,255,255,0.08); color: var(--text-muted); padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.72rem;">v${doc.version || 1}</span>`;
        const sourceBadge = `<span style="font-size: 0.75rem; color: var(--text-dim);">${doc.source || 'staff'}</span>`;

        return `
          <tr>
            <td>
              <div style="font-weight: 700; color: var(--text-main);">${escapeHtml(doc.title || 'Senza Titolo')}</div>
              <div style="font-size: 0.76rem; color: var(--text-muted); max-width: 380px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(doc.content || '')}</div>
            </td>
            <td>${catBadge}</td>
            <td>${sourceBadge}</td>
            <td>${verBadge}</td>
            <td>
              <div style="display: flex; gap: 0.4rem;">
                <button type="button" class="btn btn-outline btn-sm" onclick="rollbackSentinelKnowledge('${doc.id}', ${doc.version || 1})" title="Rollback versione"><i class="fa-solid fa-clock-rotate-left"></i></button>
                <button type="button" class="btn btn-danger btn-sm" onclick="deleteSentinelKnowledge('${doc.id}')" title="Elimina documento"><i class="fa-solid fa-trash-can"></i></button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterSentinelKnowledge() {
      const query = (document.getElementById('sentinelKbSearch')?.value || '').toLowerCase().trim();
      const cat = document.getElementById('sentinelKbCatFilter')?.value || '';

      const filtered = sentinelKbCache.filter(doc => {
        const matchQuery = !query || 
          (doc.title && doc.title.toLowerCase().includes(query)) ||
          (doc.content && doc.content.toLowerCase().includes(query)) ||
          (Array.isArray(doc.keywords) && doc.keywords.some(k => k.toLowerCase().includes(query)));
        const matchCat = !cat || doc.category === cat;
        return matchQuery && matchCat;
      });

      renderSentinelKnowledge(filtered);
    }

