      }
      .metric-val, .stat-card-value {
        font-size: 1.25rem !important;
        text-align: center !important;
      }
      .metric-label, .stat-card-title {
        font-size: 0.65rem !important;
        letter-spacing: 0.4px !important;
        text-align: center !important;
      }
      .floating-save-content {
        flex-direction: column !important;
        align-items: stretch !important;
      }
      .floating-save-actions {
        width: 100% !important;
        justify-content: flex-end !important;
      }
      .floating-save-actions .btn-save {
        width: 100% !important;
        justify-content: center !important;
      }
      .probot-hero-card {
        padding: 1rem 0.85rem !important;
      }
      .hero-stats-pills {
        gap: 0.4rem !important;
      }
    }
  
    /* Live SSE Dot Indicator */
    .sse-indicator {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 0.35rem 0.75rem;
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text-dim);
    }
    .sse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--text-dim);
      display: inline-block;
      transition: all 0.3s ease;
    }
    .sse-indicator.connected .sse-dot {
      background: #5865F2;
      box-shadow: 0 0 8px rgba(88, 101, 242, 0.6);
    }
    .sse-indicator.connected span { color: var(--text-muted); }

    /* Header Command Palette Trigger */
    .header-cmd-search {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: #15161b;
      border: 1px solid var(--border);
      border-radius: 8px;
      height: 36px;
      padding: 0 0.85rem;
      color: var(--text-muted);
      font-size: 0.82rem;
      cursor: pointer;
      margin-left: 1.5rem;
      transition: all 0.15s;
    }
    .header-cmd-search:hover {
      border-color: var(--border-hover);
      background: #18191f;
      color: var(--text-main);
    }
    .cmd-kbd {
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.1rem 0.35rem;
      font-size: 0.7rem;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-dim);
    }

    /* Command Palette Modal */
    .cmd-palette-container {
      background: #15161b;
      border: 1px solid var(--border-hover);
      border-radius: 14px;
      width: min(620px, 94vw);
      box-shadow: 0 24px 60px rgba(0,0,0,0.85);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      animation: modalFadeIn 0.15s ease;
    }
    .cmd-palette-input-wrap {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 1.1rem 1.35rem;
      border-bottom: 1px solid var(--border);
      background: #121317;
    }
    .cmd-palette-input-wrap i { color: var(--text-dim); font-size: 1.1rem; }
    .cmd-palette-input {
      flex: 1;
      background: none;
      border: none;
      color: var(--text-main);
      font-size: 1.05rem;
      font-weight: 600;
      outline: none;
    }
    .cmd-palette-esc {
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.15rem 0.45rem;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-dim);
      cursor: pointer;
    }
    .cmd-palette-results {
      max-height: 380px;
      overflow-y: auto;
      padding: 0.5rem;
    }
    .cmd-palette-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.12s;
    }
    .cmd-palette-item:hover, .cmd-palette-item.selected {
      background: rgba(88, 101, 242, 0.15);
    }
    .cmd-palette-footer {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.65rem 1.35rem;
      border-top: 1px solid var(--border);
      background: #101115;
      font-size: 0.75rem;
      color: var(--text-dim);
    }
    .cmd-palette-footer kbd {
      background: rgba(255,255,255,0.06);
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      font-family: monospace;
    }

    /* Modern Responsive Data Tables */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.85rem;
    }
    .data-table th {
      background: rgba(255,255,255,0.02);
      border-bottom: 1px solid var(--border);
      padding: 0.85rem 1rem;
      color: var(--text-dim);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.5px;
    }
    .data-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
      color: var(--text-main);
      vertical-align: middle;
    }
    .data-table tr:hover td {
      background: rgba(255,255,255,0.02);
    }
    .diag-check-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 0.85rem 1.15rem;
    }
    .diag-check-row.ok { border-color: rgba(88, 101, 242, 0.25); }
    .diag-text { flex: 1; }
    .diag-title { font-weight: 700; font-size: 0.88rem; color: var(--text-main); }
    .diag-desc { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.15rem; }
    .text-green { color: var(--primary); font-size: 1.15rem; }
    .text-blue { color: var(--primary); font-size: 1.15rem; }
    .text-yellow { color: var(--accent-yellow); font-size: 1.15rem; }
    .badge-tag.green { background: rgba(88, 101, 242, 0.08); color: #818cf8; border: 1px solid rgba(88, 101, 242, 0.2); }
    .badge-tag.blue { background: rgba(88, 101, 242, 0.15); color: #5865F2; border: 1px solid rgba(88, 101, 242, 0.3); }
    .badge-tag.yellow { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .badge-tag.red { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }

  
    /* UNIFIED WORKSPACE / SUB HEADER */
    .workspace-header, .sub-header {
      margin-bottom: 1.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .workspace-title, .sub-header-left {
      display: flex;
      align-items: center;
      gap: 1.1rem;
    }
    .header-icon, .sub-header-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--squircle-radius) !important;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      color: #5865F2;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      transition: all 0.15s ease;
    }
    .workspace-title h2, .sub-title {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.02em;
      margin: 0;
      line-height: 1.2;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .workspace-title p, .sub-desc {
      font-size: 0.86rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
      line-height: 1.4;
    }
    .sub-header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    /* UNIFIED CARDS */
    .dashboard-card, .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--card-radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      transition: border-color 0.15s ease, background 0.15s ease;
      box-sizing: border-box;
    }
    .dashboard-card:hover, .card:hover {
      border-color: var(--border-hover);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--border);
      gap: 1rem;
    }
    .card-title {
      font-size: 1.02rem;
      font-weight: 800;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 0.55rem;
      letter-spacing: -0.01em;
    }
    .card-title i {
      color: #5865F2 !important;
      font-size: 0.95rem;
    }
    .card-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
      font-weight: 400;
      line-height: 1.35;
    }

    /* UNIFIED STAT CARDS & METRIC BOXES */
    .stat-card, .metric-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--card-radius);
      padding: 1.25rem 1.15rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 0.55rem;
      transition: all 0.15s ease;
      box-sizing: border-box;
      width: 100%;
    }
    .stat-card:hover, .metric-box:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-1px);
    }
    .stat-card-title, .metric-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-dim);
      text-align: center !important;
      width: 100%;
      margin: 0;
      display: block;
    }
    .stat-card-value, .metric-val {
      font-size: 1.6rem;
      font-weight: 900;
      color: var(--text-main);
      line-height: 1.15;
      text-align: center !important;
      width: 100%;
      margin: 0 0 0.2rem 0;
      letter-spacing: -0.01em;
      font-variant-numeric: tabular-nums;
      display: block;
    }
    .stat-card-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.35;
      text-align: center !important;
      width: 100%;
    }

    /* SUB-SETTING BOX */
    .setting-item-box {
      background: var(--bg-surface);
      padding: 1.1rem 1.25rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      transition: border-color 0.15s ease;
      box-sizing: border-box;
    }
    .setting-item-box:hover {
      border-color: var(--border-hover);
    }

    /* UNIFIED DATA TABLES */
    .data-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      text-align: left;
      font-size: 0.86rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .data-table th {
      background: #13141a;
      padding: 0.85rem 1.15rem;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-dim);
      border-bottom: 1px solid var(--border);
    }
    .data-table td {
      padding: 0.9rem 1.15rem;
      border-bottom: 1px solid var(--border);
      color: var(--text-main);
      font-weight: 500;
      vertical-align: middle;
      background: var(--bg-card);
    }
    .data-table tr:last-child td {
      border-bottom: none;
    }
    .data-table tr:hover td {
      background: var(--bg-card-hover);
    }

    /* REFINED MONOCHROMATIC BADGES (ANTI-CHATGPTOSO) */
    .badge-tag {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.22rem 0.55rem;
      border-radius: var(--squircle-radius);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      letter-spacing: 0.2px;
    }
    .badge-tag.green, .badge-tag.ok {
      background: rgba(88, 101, 242, 0.08);
      color: #818cf8;
      border: 1px solid rgba(88, 101, 242, 0.2);
    }
    .badge-tag.blue {
      background: rgba(88, 101, 242, 0.08);
      color: #818cf8;
      border: 1px solid rgba(88, 101, 242, 0.2);
    }
    .badge-tag.yellow, .badge-tag.warn {
      background: rgba(245, 158, 11, 0.08);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .badge-tag.red, .badge-tag.danger {
      background: rgba(239, 68, 68, 0.08);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.2);
    }

  
    .color-picker-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .color-picker-input {
      width: 44px;
      height: 38px;
      border: 1px solid var(--border);
      border-radius: var(--control-radius);
      background: var(--bg-input);
      cursor: pointer;
      padding: 2px;
      box-sizing: border-box;
      transition: border-color 0.15s ease;
    }
    .color-picker-input:hover {
      border-color: var(--border-hover);
    }
    .form-control-mono {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      width: 110px;
    }
    .minigame-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--card-radius);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.15s ease;
      box-sizing: border-box;
    }
    .minigame-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-1px);
    }
    .minigame-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
    }
    .minigame-footer {
      margin-top: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
      padding-top: 0.5rem;
    }

  
    .setting-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-main);
    }
    .setting-desc {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin-top: 0.15rem;
      line-height: 1.35;
    }
    .minigame-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .minigame-name i {
      color: #5865F2 !important;
      font-size: 1rem;
    }
    .minigame-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.35;
      margin-top: 0.35rem;
    }
    .minigame-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
    }
    .empty-state {
      text-align: center;
      color: var(--text-muted);
      padding: 2.5rem 1.5rem;
      font-size: 0.88rem;
    }
    .table-responsive {
      width: 100%;
      overflow-x: auto;
      margin-bottom: 0.5rem;
    }

  
    /* PAGE STABILITY & TOP-LEFT INTERACTION */
    body {
      opacity: 1;
    }
    .app-container {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .brand-link {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
      padding: 0.35rem 0.65rem 0.35rem 0.35rem;
      border-radius: 12px;
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }
    .brand-link:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    .brand-link:hover .bot-icon {
      transform: scale(1.06);
      box-shadow: 0 0 16px rgba(88, 101, 242, 0.5);
    }
    .brand-badge-pill {
      font-size: 0.68rem;
      font-weight: 800;
      padding: 0.18rem 0.55rem;
      border-radius: 6px;
      background: rgba(88, 101, 242, 0.12);
      color: #818cf8;
      border: 1px solid rgba(88, 101, 242, 0.25);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

  </style>
</head>
<body>

  <!-- Top Sticky Header -->
  <header>
    <div class="brand-group">
      <button type="button" class="mobile-menu-btn" onclick="toggleMobileSidebar()"><i class="fa-solid fa-bars"></i></button>
      <a href="/" class="brand-link" title="Torna alla selezione server (Home)">
        <img src="/img/butterfly_avatar.jpg" class="bot-icon supercircle" alt="RoomUp Logo">
        <span class="logo">RoomUp!</span>
        <span class="brand-badge-pill">Dashboard</span>
      </a>

      <!-- ProBot Quick Server Dropdown Switcher -->
      <div class="probot-server-switcher" style="position: relative; display: inline-flex; align-items: center;">
        <button type="button" class="btn-server-select" onclick="toggleServerDropdown(event)" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 12px; height: 38px; padding: 0 0.85rem; display: flex; align-items: center; gap: 0.6rem; color: #fff; font-size: 0.86rem; font-weight: 700; cursor: pointer; transition: all 0.2s;">
          <% if (guildIcon) { %>
            <img src="<%= guildIcon %>" alt="<%= guildName %>" style="width: 22px; height: 22px; border-radius: 6px; object-fit: cover;">
          <% } else { %>
            <div style="width: 22px; height: 22px; border-radius: 6px; background: #8b5cf6; display: flex; align-items: center; justify-content: center; font-size: 0.72rem;"><%= guildName.slice(0, 2).toUpperCase() %></div>
          <% } %>
          <span style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= guildName %></span>
          <i class="fa-solid fa-chevron-down" style="font-size: 0.72rem; color: var(--text-muted);"></i>
        </button>

        <div id="probotServerDropdown" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; min-width: 240px; background: #141726; border: 1px solid var(--border-hover); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 20px rgba(139,92,246,0.2); z-index: 999; padding: 0.5rem; flex-direction: column; gap: 0.25rem;">
          <div style="font-size: 0.72rem; font-weight: 800; color: var(--text-dim); text-transform: uppercase; padding: 0.35rem 0.65rem; letter-spacing: 0.5px;">I Tuoi Server</div>
          <% (allGuilds || []).forEach(g => { %>
            <a href="/dashboard/<%= g.id %>" style="display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0.65rem; border-radius: 8px; text-decoration: none; color: <%= g.id === guildId ? '#c4b5fd' : '#f8fafc' %>; background: <%= g.id === guildId ? 'rgba(139, 92, 246, 0.15)' : 'transparent' %>; font-size: 0.85rem; font-weight: 600; transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='<%= g.id === guildId ? 'rgba(139, 92, 246, 0.15)' : 'transparent' %>'">
              <% if (g.icon) { %>
                <img src="<%= g.icon %>" alt="<%= g.name %>" style="width: 24px; height: 24px; border-radius: 6px; object-fit: cover;">
              <% } else { %>
                <div style="width: 24px; height: 24px; border-radius: 6px; background: #2a2e45; display: flex; align-items: center; justify-content: center; font-size: 0.72rem;"><%= g.name.slice(0, 2).toUpperCase() %></div>
              <% } %>
              <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= g.name %></span>
              <% if (g.id === guildId) { %><i class="fa-solid fa-check" style="font-size: 0.8rem; color: #10b981;"></i><% } %>
            </a>
          <% }) %>
          <div style="border-top: 1px solid var(--border); margin: 0.35rem 0;"></div>
          <a href="/" style="display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0.65rem; border-radius: 8px; text-decoration: none; color: var(--text-muted); font-size: 0.82rem; font-weight: 600;">
            <i class="fa-solid fa-compass"></i> Tutti i Server
          </a>
        </div>
      </div>
      <div class="header-cmd-search" onclick="openCmdPalette()" title="Apri Command Palette (Ctrl+K)">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Cerca o salta a un modulo...</span>
        <span class="cmd-kbd">Ctrl+K</span>
      </div>
    </div>

    <div class="header-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="header-user-pill">
          <img src="<%= user.avatarUrl %>" alt="Avatar">
          <span><%= user.global_name || user.username %></span>
        </div>
      <% } %>

      <a href="/" class="btn-refresh" title="I miei server"><i class="fa-solid fa-server"></i> Server</a>
      <a href="/logout" class="btn-refresh logout" title="Disconnetti account Discord"><i class="fa-solid fa-right-from-bracket"></i> Esci</a>
      <div id="sseIndicator" class="sse-indicator" title="Connessione Realtime attiva">
        <span class="sse-dot"></span> <span>Live SSE</span>
      </div>
      <button type="button" class="btn-save" id="saveButton" onclick="saveAllSettings()"><i class="fa-solid fa-floppy-disk"></i> Salva</button>
    </div>
  </header>

  <div class="app-container">

    <!-- Far Left Rail: Server Switcher (Discord Native Pill) -->
    <div class="mini-server-bar">
      <div class="mini-server-item">
        <a href="/" class="mini-server-btn supercircle" title="Tutti i Server">
