        },
        modmail: {
          enabled: getChecked('modmail_enabled'),
          categoryId: getVal('modmail_categoryId'),
          staffRoleId: getVal('modmail_staffRoleId')
        },
        economy: {
          enabled: getChecked('eco_enabled'),
          currencyName: getVal('eco_currencyName', 'Monete'),
          currencySymbol: getVal('eco_currencySymbol', '🪙'),
          dailyAmount: getInt('eco_dailyAmount', 50),
          startingBalance: getInt('eco_startingBalance', 100)
        },
        social: {
          birthdayChannelId: getVal('social_birthdayChannelId'),
          birthdayRoleId: getVal('social_birthdayRoleId'),
          confessionChannelId: getVal('social_confessionChannelId'),
          requireReview: getChecked('social_requireReview')
        }
      };

      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/save`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(masterPayload)
        });
        const data = await res.json();
        if (data.success) {
          hasUnsavedChanges = false;
          document.getElementById('floatingSaveBar')?.classList.remove('visible');
          showToast("Modifiche salvate!");
        } else {
          showToast("Errore salvataggio: " + (data.message || "Riprova"), true);
        }
      } catch (err) {
        showToast("Errore di connessione", true);
      } finally {
        if (headerBtn) { headerBtn.innerHTML = origHeader; headerBtn.disabled = false; }
        if (floatBtn) { floatBtn.innerHTML = origFloat; floatBtn.disabled = false; }
      }
    }

    // Dispatch Ticket Panel via AJAX
    async function dispatchTicketPanel() {
      const channelId = getVal('sendTicketChannelId');
      if (!channelId) {
        showToast("Seleziona un canale", true);
        return;
      }
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/panel/ticket`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ channelId })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Pannello ticket inviato!");
        } else {
          showToast(data.message, true);
        }
      } catch (e) {
        showToast("Errore invio pannello", true);
      }
    }

    // Dispatch Verification Panel via AJAX
    async function dispatchVerifyPanel() {
      const channelId = getVal('sendVerifyChannelId');
      if (!channelId) {
        showToast("Seleziona un canale", true);
        return;
      }
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/panel/verify`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ channelId })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Pannello verifica inviato!");
        } else {
          showToast(data.message, true);
        }
      } catch (e) {
        showToast("Errore invio pannello", true);
      }
    }

    // Delete Partnership
    async function deletePartnership(partnerNumber) {
      if (!confirm(`Vuoi eliminare la partnership #${partnerNumber}?`)) return;
      try {
        const res = await fetch(`/api/dashboard/${GUILD_ID}/partnership/delete`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ partnerNumber })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Partnership eliminata");
          setTimeout(() => location.reload(), 1200);
        } else {
          showToast(data.message, true);
        }
      } catch (e) {
        showToast("Errore eliminazione partnership", true);
      }
    }
  
    // ================= REAL-TIME SSE INTEGRATION =================
    try {
      const sse = new EventSource('/api/dashboard/' + GUILD_ID + '/events');
      sse.onopen = () => {
        const ind = document.getElementById('sseIndicator');
        if (ind) ind.classList.add('connected');
      };
      sse.onmessage = (e) => {
        try {
          const data = JSON.parse(e.data);
          if (data.type === 'ping') return;
          showToast("Live Event: " + (data.type || "aggiornamento"));
        } catch(err) {}
      };
      sse.onerror = () => {
        const ind = document.getElementById('sseIndicator');
        if (ind) ind.classList.remove('connected');
      };
    } catch(e) {}

