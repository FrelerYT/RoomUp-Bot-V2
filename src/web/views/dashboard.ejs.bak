      { label: "Anti-Nuke & Panic Mode", tab: "tab-antinuke", cat: "Sicurezza", icon: "fa-triangle-exclamation" },
      { label: "AutoMod Filtro Parole", tab: "tab-automod", cat: "Sicurezza", icon: "fa-shield-virus" },
      { label: "Sanzioni & Warn", tab: "tab-warns", cat: "Sicurezza", icon: "fa-gavel" },
      { label: "Registro Casi & Prove", tab: "tab-cases", cat: "Moderazione", icon: "fa-scale-balanced" },
      { label: "Segnalazioni & Ricorsi", tab: "tab-appeals", cat: "Moderazione", icon: "fa-user-shield" },
      { label: "Sentinel AI Moderator", tab: "tab-aimod", cat: "Moderazione", icon: "fa-brain" },
      { label: "Audit Logs (157+ Eventi)", tab: "tab-logs", cat: "Moderazione", icon: "fa-list-check" },
      { label: "Ticket di Supporto", tab: "tab-tickets", cat: "Supporto", icon: "fa-ticket" },
      { label: "Modmail Privato", tab: "tab-modmail", cat: "Supporto", icon: "fa-envelope-open-text" },
      { label: "Moduli & Candidature", tab: "tab-forms", cat: "Supporto", icon: "fa-file-signature" },
      { label: "Knowledge Base & FAQ", tab: "tab-knowledge-base", cat: "Supporto", icon: "fa-book-bookmark" },
      { label: "Economia & Saldi", tab: "tab-economy", cat: "Community", icon: "fa-coins" },
      { label: "Reputazione Membri", tab: "tab-reputation", cat: "Community", icon: "fa-award" },
      { label: "Missioni Quotidiane", tab: "tab-quests", cat: "Community", icon: "fa-list-check" },
      { label: "Compleanni & Confessioni", tab: "tab-social", cat: "Community", icon: "fa-cake-candles" },
      { label: "Livelli & XP Chat", tab: "tab-levels", cat: "Community", icon: "fa-trophy" },
      { label: "Minigiochi Suite (15 Giochi)", tab: "tab-entertainment", cat: "Giochi", icon: "fa-gamepad" },
      { label: "Gioco del Conteggio", tab: "tab-counting", cat: "Giochi", icon: "fa-arrow-down-1-9" },
      { label: "Stanze Vocali Temporanee", tab: "tab-voice", cat: "Vocali", icon: "fa-microphone-lines" },
      { label: "Giveaway Community", tab: "tab-giveaways", cat: "Community", icon: "fa-gift" },
      { label: "Suggerimenti", tab: "tab-suggestions", cat: "Community", icon: "fa-lightbulb" },
      { label: "Partnership Sincronizzate", tab: "tab-partnerships", cat: "Community", icon: "fa-handshake" },
      { label: "Workflow Builder Grafico", tab: "tab-automations", cat: "Automazioni", icon: "fa-network-wired" },
      { label: "Integrazioni Minecraft & GitHub", tab: "tab-integrations", cat: "Integrazioni", icon: "fa-cube" },
      { label: "Assistente AI Intelligente", tab: "tab-aiagent", cat: "AI", icon: "fa-wand-magic-sparkles" },
      { label: "Sondaggi & Utility", tab: "tab-utilities", cat: "Utility", icon: "fa-square-poll-vertical" }
    ];

    let paletteSelectedIdx = 0;

    function openCmdPalette() {
      const m = document.getElementById('cmdPaletteModal');
      const input = document.getElementById('cmdPaletteInput');
      if (m && input) {
        m.classList.add('open');
        input.value = '';
        renderPaletteResults('');
        input.focus();
      }
    }

    function closeCmdPalette() {
      document.getElementById('cmdPaletteModal')?.classList.remove('open');
    }

    function handlePaletteBackdrop(e) {
      if (e.target.id === 'cmdPaletteModal') closeCmdPalette();
    }

    function renderPaletteResults(q) {
      const container = document.getElementById('cmdPaletteResults');
      if (!container) return;
      const query = q.toLowerCase().trim();
      const filtered = PALETTE_ITEMS.filter(item => 
        !query || item.label.toLowerCase().includes(query) || item.cat.toLowerCase().includes(query)
      );

      paletteSelectedIdx = 0;
      if (filtered.length === 0) {
        container.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: var(--text-dim);">Nessun risultato per "' + q + '".</div>';
        return;
      }

      container.innerHTML = filtered.map((item, idx) => `
        <div class="cmd-palette-item ${idx === 0 ? 'selected' : ''}" onclick="selectPaletteItem('${item.tab}')" data-idx="${idx}">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <i class="fa-solid ${item.icon}" style="color: var(--primary); width: 18px;"></i>
            <span style="font-weight: 700; color: var(--text-main);">${item.label}</span>
          </div>
          <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">${item.cat}</span>
        </div>
      `).join('');
    }

    function selectPaletteItem(tabId) {
      closeCmdPalette();
      switchTab(tabId);
    }

    document.getElementById('cmdPaletteInput')?.addEventListener('input', (e) => {
      renderPaletteResults(e.target.value);
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openCmdPalette();
      }
      if (e.key === 'Escape') {
        closeCmdPalette();
      }
    });

    // ================= MODULAR AJAX HANDLERS =================
    async function runLiveDiagnostics() {
      showToast("Esecuzione diagnostica live in corso...");
      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/diagnostics');
        const data = await res.json();
        if (data.success && data.health) {
          document.getElementById('diagScore').textContent = data.health.score + '%';
          showToast("Diagnostica completata con successo!");
        }
      } catch(e) {
        showToast("Errore durante la diagnostica", true);
      }
    }

    async function applyPreset(presetId) {
      if (!confirm("Applicare il preset " + presetId + "? Verranno generati canali e ruoli consigliati.")) return;
      showToast("Applicazione preset in corso...");
      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/presets/apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ presetId })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          setTimeout(() => location.reload(), 1200);
        } else {
          showToast(data.message, true);
        }
      } catch(e) {
        showToast("Errore applicazione preset", true);
      }
    }

    async function createGuildBackup() {
      showToast("Generazione backup in corso...");
      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/backups/create', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          showToast("Backup creato con successo!");
          setTimeout(() => location.reload(), 1200);
        }
      } catch(e) {
        showToast("Errore creazione backup", true);
      }
    }

    async function submitKnowledgeArticle() {
      const category = getVal('kb_category');
      const title = getVal('kb_title');
      const keywords = getVal('kb_keywords');
      const content = getVal('kb_content');
      if (!title || !content) {
        showToast("Inserisci titolo e contenuto per l'articolo", true);
        return;
      }
      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/kb', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category, title, keywords, content })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Articolo aggiunto alla Knowledge Base!");
          setTimeout(() => location.reload(), 1200);
        }
      } catch(e) {
        showToast("Errore salvataggio FAQ", true);
      }
    }

    async function adjustUserBalance() {
      const userId = getVal('eco_adjustUserId');
      const amount = getVal('eco_adjustAmount');
      const type = getVal('eco_adjustType', 'wallet');
      if (!userId || !amount) {
        showToast("Inserisci ID utente e quantità", true);
        return;
      }
      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/economy/adjust', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, amount, type })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          setTimeout(() => location.reload(), 1200);
        }
      } catch(e) {
        showToast("Errore aggiornamento saldo", true);
      }
    }

    async function createWorkflowDirect() {
      const name = getVal('auto_name');
      const trigger = getVal('auto_trigger');
      const actionType = getVal('auto_actionType');
      const target = getVal('auto_actionTarget');
      const payload = getVal('auto_actionPayload');

      if (!name) {
        showToast("Inserisci un nome per il workflow", true);
        return;
      }

      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/automations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            trigger,
            actions: [{ type: actionType, target, payload }]
          })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Automazione creata e attiva!");
          setTimeout(() => location.reload(), 1200);
        }
      } catch(e) {
        showToast("Errore creazione automazione", true);
      }
    }

    async function deleteWorkflowDirect(autoId) {
      if (!confirm("Eliminare questa automazione?")) return;
      try {
        const res = await fetch('/api/dashboard/' + GUILD_ID + '/automations/' + autoId, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          showToast("Automazione eliminata");
          setTimeout(() => location.reload(), 1000);
        }
      } catch(e) {
        showToast("Errore eliminazione automazione", true);
      }
    }

  </script>

  <!-- ================= COMMAND PALETTE (CTRL+K) ================= -->
  <div id="cmdPaletteModal" class="modal-overlay" onclick="handlePaletteBackdrop(event)">
    <div class="cmd-palette-container" onclick="event.stopPropagation()">
      <div class="cmd-palette-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="cmdPaletteInput" class="cmd-palette-input" placeholder="Digita per cercare comandi, canali, moduli o impostazioni..." autocomplete="off">
        <span class="cmd-palette-esc" onclick="closeCmdPalette()">ESC</span>
      </div>
      <div class="cmd-palette-results" id="cmdPaletteResults">
        <!-- Results populated dynamically by JavaScript -->
      </div>
      <div class="cmd-palette-footer">
        <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> per navigare</span>
        <span><kbd>Enter</kbd> per selezionare</span>
        <span><kbd>ESC</kbd> per chiudere</span>
      </div>
    </div>
  </div>

</body>
</html>
