      const gameKeys = [
        'trivia', 'math', 'rps', 'slots', 'roulette', 'blackjack',
        'eightball', 'mysterybox', 'grattaevinci', 'ruotafortuna',
        'indovina', 'dadi', 'tris', 'coinflip', 'meme'
      ];
